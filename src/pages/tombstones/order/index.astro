---
import SiteLayout from '../../../layouts/SiteLayout.astro';
const product = Astro.url.searchParams.get('product') ?? 'your selected tombstone';
---
<SiteLayout title="Start your tombstone order" description="Personalise your TIRO tombstone order and choose installation details.">
  <section class="order-page section"><div class="container order-shell"><a class="back-link" href="/tombstones/">← Back to catalogue</a><div class="order-heading"><p class="eyebrow">Start your order</p><h1>Make it personal.</h1><p>You selected <strong>{product}</strong>. Share the details TIRO needs to prepare your order.</p></div><div class="order-layout"><aside class="order-summary"><p class="summary-label">Selected tombstone</p><h2>{product}</h2><p>Final price and installation availability are confirmed by TIRO before payment.</p><p>Lay-by can run for up to 24 months.</p></aside><form id="order-form"><section><p class="eyebrow">Personalisation</p><h2>Remember them with care.</h2><label>Deceased person’s full name<input name="deceasedName" required /></label><label>Inscription <span class="optional">Optional</span><textarea name="inscription" rows="4" placeholder="Share the wording you would like to discuss with TIRO."></textarea></label></section><section><p class="eyebrow">Installation</p><h2>Where should we install it?</h2><div class="fields"><label>Province<select name="province" required><option value="">Choose province</option><option>Eastern Cape</option><option>Free State</option><option>Gauteng</option><option>KwaZulu-Natal</option><option>Limpopo</option><option>Mpumalanga</option><option>North West</option><option>Northern Cape</option><option>Western Cape</option></select></label><label>Town<input name="town" required /></label></div><label>Cemetery<input name="cemetery" required /></label><aside class="info-note"><strong>Installation check</strong><span>TIRO will confirm coverage, foundation, brickwork and transport requirements for this location.</span></aside></section><section><p class="eyebrow">Contact and payment</p><h2>How should TIRO contact you?</h2><div class="fields"><label>Your full name<input name="contactName" autocomplete="name" required /></label><label>Mobile number<input name="phone" type="tel" autocomplete="tel" required /></label></div><label>Email address<input name="email" type="email" autocomplete="email" required /></label><fieldset><legend>Payment preference</legend><label class="payment-choice"><input type="radio" name="paymentPreference" value="pay_in_full" required /><span><strong>Pay in full</strong><small>TIRO will confirm payment options before checkout.</small></span></label><label class="payment-choice"><input type="radio" name="paymentPreference" value="lay_by" required /><span><strong>Lay-by</strong><small>Spread payments over up to 24 months.</small></span></label></fieldset></section><p class="form-error" id="order-error" role="alert" hidden>Please complete the required order details.</p><button type="submit" class="button button-primary" id="submit-order">Send order request <span aria-hidden="true">›</span></button><p class="privacy-note">TIRO’s website does not permanently store your personalisation or contact details.</p><section class="complete" id="order-complete" hidden aria-live="polite"><p class="eyebrow">Order status</p><h2>TIRO has your request.</h2><p id="complete-message">Your order has been sent for review.</p><a class="button button-secondary" href="/tombstones/">Back to catalogue</a></section></form></div></div></section>
</SiteLayout>
<script define:vars={{ product }}>
  const form = document.querySelector('#order-form'); const error = document.querySelector('#order-error'); const button = document.querySelector('#submit-order'); const complete = document.querySelector('#order-complete'); const message = document.querySelector('#complete-message');
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.checkValidity()) { error.hidden = false; form.reportValidity(); return; } error.hidden = true; button.disabled = true; button.textContent = 'Sending securely…'; const data = Object.fromEntries(new FormData(form).entries()); const payload = { product, personalisation: { deceasedName: String(data.deceasedName), inscription: String(data.inscription ?? '') }, installation: { province: String(data.province), town: String(data.town), cemetery: String(data.cemetery) }, contact: { name: String(data.contactName), phone: String(data.phone), email: String(data.email) }, paymentPreference: String(data.paymentPreference) };
    try { const response = await fetch('/api/tombstones/submit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }); const result = await response.json(); if (result.status === 'failed') throw new Error(result.messages?.[0] ?? 'We could not send your order request.'); complete.hidden = false; message.textContent = result.status === 'unavailable' ? 'The secure TIRO order handoff is ready to connect when the client order API is available.' : (result.messages?.[0] ?? 'TIRO will confirm the next step shortly.'); button.hidden = true; } catch (reason) { error.textContent = reason instanceof Error ? reason.message : 'We could not send your order request.'; error.hidden = false; button.disabled = false; button.innerHTML = 'Send order request <span aria-hidden="true">›</span>'; } });
</script>
<style>
  .order-page { min-height: 75vh; background: var(--tiro-soft-white); }.order-shell { max-width: 1100px; }.back-link { display: inline-block; margin-bottom: 40px; color: var(--tiro-blue); font-weight: 800; text-underline-offset: 5px; }.order-heading { max-width: 700px; }.order-heading h1 { margin: 10px 0 16px; color: var(--tiro-navy); font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.06; letter-spacing: -.045em; }.order-heading > p:not(.eyebrow) { font-size: 1.1rem; }.order-layout { display: grid; gap: 24px; margin-top: 40px; align-items: start; }.order-summary, #order-form { padding: 28px; border: 1px solid var(--tiro-light-grey); border-radius: 24px; background: white; }.summary-label { margin: 0; color: var(--tiro-red); font-size: .8rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }.order-summary h2 { margin: 10px 0; color: var(--tiro-navy); font-size: 1.4rem; }.order-summary p:not(.summary-label) { color: var(--tiro-grey); font-size: .9rem; }.order-layout form { display: grid; gap: 32px; }.order-layout h2 { margin: 8px 0 20px; color: var(--tiro-navy); font-size: clamp(1.5rem, 3vw, 2.1rem); }.order-layout label { display: grid; gap: 7px; margin-top: 14px; color: var(--tiro-navy); font-size: .9rem; font-weight: 800; }.order-layout input, .order-layout select, .order-layout textarea { width: 100%; min-height: 52px; padding: 12px; border: 1px solid #b7c2d1; border-radius: 12px; background: white; }.order-layout textarea { min-height: 120px; resize: vertical; }.optional { color: var(--tiro-grey); font-weight: 500; }.fields { display: grid; gap: 14px; }.info-note { display: grid; gap: 4px; margin-top: 20px; padding: 14px; border-radius: 12px; background: #edf3fb; color: var(--tiro-navy); font-size: .87rem; }.order-layout fieldset { margin: 24px 0 0; padding: 0; border: 0; }.order-layout legend { color: var(--tiro-navy); font-size: .9rem; font-weight: 800; }.order-layout .payment-choice { min-height: 76px; grid-template-columns: 22px 1fr; align-items: center; padding: 13px; border: 2px solid var(--tiro-light-grey); border-radius: 14px; }.payment-choice:has(input:checked) { border-color: var(--tiro-blue); }.payment-choice input { width: 20px; min-height: 20px; accent-color: var(--tiro-red); }.payment-choice span { display: grid; gap: 3px; }.payment-choice small { color: var(--tiro-grey); font-size: .8rem; font-weight: 500; }.form-error { margin: 0; color: #a31220; font-weight: 800; }.privacy-note { margin: -20px 0 0; color: var(--tiro-grey); font-size: .8rem; }.complete { padding: 20px; border-radius: 16px; background: #edf3fb; }.complete h2 { margin: 8px 0; }.complete p:not(.eyebrow) { color: var(--tiro-grey); } @media (min-width: 760px) { .fields { grid-template-columns: 1fr 1fr; } } @media (min-width: 950px) { .order-layout { grid-template-columns: 280px 1fr; }.order-summary { position: sticky; top: 24px; } }
</style>
