---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicTombstoneCatalogue } from '../../lib/supabase/catalogue';

export const prerender = false;

const { tombstoneCategories, tombstones } = await getPublicTombstoneCatalogue();
---
<SiteLayout title="Tombstones" description="Browse the TIRO 2026 tombstone catalogue, including lay-by options.">
  <section class="shop-hero"><div class="container shop-hero-grid"><div class="shop-hero-copy"><p class="eyebrow">TIRO tombstones</p><h1>Find the right memorial.</h1><p>Browse the 2026 range, personalise your selection and arrange installation. Lay-by is available for up to 24 months.</p><div class="shop-hero-actions"><a class="button button-primary" href="#product-grid">Browse tombstones <span aria-hidden="true">›</span></a><a class="shop-hero-link" href="/tombstones/custom/">Create a custom memorial <span aria-hidden="true">›</span></a></div></div><div class="shop-hero-image-wrap"><img src="/images/about/tombstone.png" alt="Polished black granite memorial with white flowers" /></div></div></section>
  <section class="shop section"><div class="container"><div class="shop-header"><div><p class="eyebrow">Browse the range</p><h2 class="heading">Tombstones for every tribute.</h2></div><button type="button" class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filters">Filter range</button></div><div class="shop-layout"><aside class="filters" id="filters"><div><p>Category</p><div class="filter-options"><button type="button" class="filter active" data-category="All">All tombstones <span>{tombstones.length}</span></button>{tombstoneCategories.map((category) => <button type="button" class="filter" data-category={category}>{category} <span>{tombstones.filter((item) => item.category === category).length}</span></button>)}</div></div><div class="source-note"><strong>Brochure source</strong><p>Catalogue information comes from the supplied 2026 TIRO Tombstones Catalogue.</p></div></aside><div><p class="result-count" id="result-count">{tombstones.length} tombstones</p><div class="product-grid" id="product-grid">{tombstones.map((item) => <article class="product-card" data-category={item.category}><a href={`/tombstones/${item.slug}/`} class="product-image"><img src={item.image} alt={`${item.name} tombstone`} loading="lazy" width="420" height="360" />{item.promotionalBadge && <span class="badge">{item.promotionalBadge}</span>}</a><div class="product-content"><p class="product-category">{item.category}</p><h3><a href={`/tombstones/${item.slug}/`}>{item.name}</a></h3>{item.previousPrice && <p class="previous">{item.previousPrice}</p>}<p class="price">{item.brochurePrices.map((price) => <span>{price}</span>)}</p><div class="card-meta">{item.laybyeEnabled && <span>Lay-by available</span>}{item.needsReview && <span>Price label to confirm</span>}</div><a href={`/tombstones/${item.slug}/`} class="card-link">View details <span aria-hidden="true">›</span></a></div></article>)}</div><p class="empty" id="empty" hidden>No tombstones match this category.</p></div></div></div></section>
  <section class="custom-cta section"><div class="container"><div><p class="eyebrow">Customised range</p><h2 class="heading">Looking for something more personal?</h2><p>Tell TIRO about your preferred design, material, budget and installation location.</p></div><a class="button button-primary" href="/tombstones/custom/">Start a custom design <span aria-hidden="true">›</span></a></div></section>
</SiteLayout>
<script>
  if (!window.location.hash) {
    window.history.scrollRestoration = 'manual';
    window.addEventListener('pageshow', () => window.scrollTo({ top: 0, left: 0, behavior: 'instant' }));
  }

  const filterToggle = document.querySelector<HTMLElement>('#filter-toggle');
  const filters = document.querySelector<HTMLElement>('#filters');
  const buttons = Array.from(document.querySelectorAll<HTMLElement>('.filter'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const count = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#empty');
  if (filterToggle && filters && count && empty) {
    filterToggle.addEventListener('click', () => { const shown = filters.classList.toggle('open'); filterToggle.setAttribute('aria-expanded', String(shown)); });
    buttons.forEach((button) => button.addEventListener('click', () => { const category = button.dataset.category; let visible = 0; buttons.forEach((item) => item.classList.toggle('active', item === button)); cards.forEach((card) => { const matches = category === 'All' || card.dataset.category === category; card.hidden = !matches; if (matches) visible += 1; }); count.textContent = `${visible} ${visible === 1 ? 'tombstone' : 'tombstones'}`; empty.hidden = visible > 0; }));
  }
</script>
<script>
  const tombstoneImages = ['/images/tombstones/01.webp', '/images/tombstones/02.webp', '/images/tombstones/03.webp', '/images/tombstones/04.webp', '/images/tombstones/05.webp', '/images/tombstones/06.webp'];
  const shuffledTombstoneImages = [...tombstoneImages].sort(() => Math.random() - .5);
  const catalogueCards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const catalogueCount = document.querySelector<HTMLElement>('#result-count');

  catalogueCards.forEach((card, index) => {
    const image = card.querySelector<HTMLImageElement>('.product-image img');
    if (image) image.src = shuffledTombstoneImages[index % shuffledTombstoneImages.length];
  });

  const limitCategoryCards = () => {
    const categoryCounts = new Map<string, number>();
    catalogueCards.forEach((card) => {
      if (card.hidden) return;
      const category = card.dataset.category ?? '';
      const count = categoryCounts.get(category) ?? 0;
      card.hidden = count >= 3;
      categoryCounts.set(category, count + 1);
    });
    const visible = catalogueCards.filter((card) => !card.hidden).length;
    if (catalogueCount) catalogueCount.textContent = `${visible} ${visible === 1 ? 'tombstone' : 'tombstones'}`;
  };

  limitCategoryCards();
  document.querySelectorAll<HTMLElement>('.filter').forEach((filter) => filter.addEventListener('click', () => requestAnimationFrame(limitCategoryCards)));
</script>
<style>
  .shop-hero { padding: clamp(68px, 9vw, 120px) 0 25px; background: var(--tiro-navy); color: white; }.shop-hero > .container { max-width: 920px; }.shop-hero .eyebrow { color: #fff; }.shop-hero h1 { max-width: 690px; margin: 12px 0 18px; font-size: clamp(2.8rem, 6vw, 4.8rem); line-height: 1; letter-spacing: -.055em; }.shop-hero > .container > p:not(.eyebrow) { max-width: 680px; font-size: clamp(1.05rem, 2vw, 1.25rem); }.shop-proof { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }.shop-proof span { padding: 8px 12px; border: 1px solid #ffffff50; border-radius: 999px; font-size: .86rem; font-weight: 700; }.shop { padding-top: 20px; background: var(--tiro-soft-white); }.shop-header { display: flex; justify-content: space-between; gap: 16px; align-items: end; margin-bottom: 32px; }.shop-header .heading { margin: 8px 0 0; }.filter-toggle { min-height: 48px; padding: 10px 16px; border: 2px solid var(--tiro-blue); border-radius: 12px; background: white; color: var(--tiro-blue); font-weight: 800; cursor: pointer; }.shop-layout { display: grid; gap: 28px; }.filters { display: none; padding: 20px; border: 1px solid var(--tiro-light-grey); border-radius: 18px; background: white; }.filters.open { display: block; }.filters > div > p { margin: 0 0 12px; color: var(--tiro-navy); font-size: .9rem; font-weight: 800; }.filter-options { display: grid; gap: 3px; }.filter { min-height: 42px; display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border: 0; border-radius: 8px; background: transparent; color: var(--tiro-charcoal); text-align: left; cursor: pointer; }.filter.active { padding-inline: 10px; background: #edf3fb; color: var(--tiro-blue); font-weight: 800; }.filter span { color: var(--tiro-grey); font-size: .8rem; }.source-note { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--tiro-light-grey); color: var(--tiro-grey); font-size: .82rem; }.source-note p { margin: 6px 0 0; }.result-count { margin: 0 0 16px; color: var(--tiro-grey); font-size: .9rem; font-weight: 700; }.product-grid { display: grid; gap: 16px; }.product-card { overflow: hidden; border: 1px solid var(--tiro-light-grey); border-radius: 20px; background: white; }.product-image { position: relative; display: block; aspect-ratio: 1.17; overflow: hidden; background: #eef1f4; }.product-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 220ms ease; }.product-card:hover .product-image img { transform: scale(1.035); }.badge { position: absolute; top: 12px; left: 12px; padding: 6px 9px; border-radius: 999px; background: var(--tiro-red); color: white; font-size: .72rem; font-weight: 800; text-transform: uppercase; }.product-content { padding: 18px; }.product-category { margin: 0; color: var(--tiro-grey); font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }.product-content h3 { margin: 7px 0 8px; color: var(--tiro-navy); font-size: 1.25rem; }.product-content h3 a { text-decoration: none; }.previous { margin: 0; color: var(--tiro-grey); font-size: .84rem; text-decoration: line-through; }.price { display: flex; flex-wrap: wrap; gap: 6px 12px; margin: 8px 0; color: var(--tiro-red); font-size: 1.05rem; font-weight: 800; }.card-meta { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }.card-meta span { padding: 4px 7px; border-radius: 5px; background: var(--tiro-soft-white); color: var(--tiro-blue); font-size: .72rem; font-weight: 700; }.card-link { color: var(--tiro-blue); font-size: .9rem; font-weight: 800; text-underline-offset: 4px; }.empty { color: var(--tiro-grey); }.custom-cta { background: white; }.custom-cta .container { display: grid; gap: 24px; align-items: center; }.custom-cta p:not(.eyebrow) { max-width: 600px; font-size: 1.06rem; } @media (min-width: 620px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } } @media (min-width: 900px) { .filter-toggle { display: none; }.shop-layout { grid-template-columns: 250px 1fr; }.filters { display: block; }.product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }.custom-cta .container { grid-template-columns: 1fr auto; } } @media (prefers-reduced-motion: reduce) { .product-card:hover .product-image img { transform: none; } }
</style>
<style>
  .shop-hero { padding: clamp(96px, 9vw, 120px) 0 clamp(68px, 7vw, 96px); }
  .shop-hero > .container { max-width: var(--content-max); }
  .shop-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 28px; }
  .shop-hero-actions .button { min-height: 48px; }
  .shop-hero-link { color: white; font-size: .94rem; font-weight: 800; text-decoration: underline; text-decoration-color: var(--tiro-red); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .shop-hero-link span { display: inline-block; margin-left: 5px; color: var(--tiro-red); font-size: 1.15em; }
  #product-grid { scroll-margin-top: 120px; }
  .shop-hero-grid { display: grid; align-items: center; gap: 42px; }
  .shop-hero-copy > p:not(.eyebrow) { max-width: 680px; font-size: clamp(1.05rem, 2vw, 1.25rem); }
  .shop-hero-image-wrap { display: none; overflow: hidden; border-radius: 24px; }
  .shop-hero-image-wrap img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 900px) { .shop-hero { position: relative; min-height: 414px; overflow: hidden; }.shop-hero-grid { position: static; display: block; min-height: 414px; }.shop-hero-copy { position: relative; z-index: 1; width: min(100%, 650px); }.shop-hero-image-wrap { position: absolute; z-index: 0; inset: 0 0 0 50%; display: block; height: auto; border-radius: 0; background: var(--tiro-navy); }.shop-hero-image-wrap::before { position: absolute; z-index: 1; inset: 0; content: ''; background: linear-gradient(90deg, var(--tiro-navy) 0%, #071a3d33 24%, transparent 52%); }.shop-hero-image-wrap img { width: 100%; height: 100%; object-position: center; object-fit: contain; transform: translateY(-75px); } }
</style>
