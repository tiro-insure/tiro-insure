---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicTombstoneCatalogue } from '../../lib/supabase/catalogue';

export const prerender = false;

const { tombstones } = await getPublicTombstoneCatalogue();
const tombstone = tombstones.find((item) => item.slug === Astro.params.slug);

if (!tombstone) return Astro.redirect('/tombstones/', 302);
---
<SiteLayout title={tombstone.name} description={`${tombstone.name} from the TIRO Tombstones Catalogue.`}>
  <section class="product-page section"><div class="container"><a class="back-link" href="/tombstones/">← Back to tombstones</a><div class="product-layout"><div class:list={['image-wrap', { 'image-wrap--3d': tombstone.model3d }]}>{tombstone.model3d ? <div class="model-stage"><model-viewer src={tombstone.model3d} alt={`${tombstone.name} interactive 3D model`} camera-controls touch-action="pan-y" interaction-prompt="auto" camera-target="0m 0.3m 0m" camera-orbit="45deg 72deg 72%" min-camera-orbit="auto auto 50%" max-camera-orbit="auto auto 180%" min-field-of-view="15deg" max-field-of-view="60deg" shadow-intensity="1" exposure="1" loading="eager"></model-viewer><div class="model-guide" aria-hidden="true"><span><b>↔</b> Drag for 360°</span><span><b class="mouse-icon"></b> Scroll to zoom</span></div></div> : <><img src={tombstone.image} alt={`${tombstone.name} tombstone`} width="700" height="600" /><span class="image-note">Image from the 2026 TIRO Tombstones Catalogue</span></>}</div><div class="details"><p class="eyebrow">{tombstone.category}</p><h1>{tombstone.name}</h1>{tombstone.promotionalBadge && <span class="badge">{tombstone.promotionalBadge}</span>}<div class="price-block">{tombstone.previousPrice && <p>{tombstone.previousPrice}</p>}{tombstone.brochurePrices.map((price) => <strong>{price}</strong>)}</div>{tombstone.needsReview && <aside class="review-note"><strong>Pricing note</strong><span>The brochure uses T/P and A/P labels. TIRO will confirm the applicable price before an order is placed.</span></aside>}<p class="description">{tombstone.description}</p><ul class="detail-list">{tombstone.model3d && <li>Interactive 360° view with rotate and zoom controls</li>}<li>Lay-by available for up to 24 months</li><li>Personalisation available after selection</li><li>Installation location confirmed during the order</li></ul><a class="button button-primary" href={`/tombstones/order/?product=${encodeURIComponent(tombstone.name)}`}>Start order <span aria-hidden="true">›</span></a><a class="save-link" href="/tombstones/custom/">Looking for a custom design? <span aria-hidden="true">›</span></a></div></div></div></section>
  {tombstone.model3d && <script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.3.1/model-viewer.min.js"></script>}
</SiteLayout>
<style>
  .product-page { background: var(--tiro-soft-white); min-height: 75vh; }.back-link { display: inline-block; margin-bottom: 36px; color: var(--tiro-blue); font-weight: 800; text-underline-offset: 5px; }.product-layout { display: grid; gap: 32px; align-items: start; }.image-wrap { position: relative; overflow: hidden; border-radius: 24px; background: white; }.image-wrap img { width: 100%; aspect-ratio: 1.15; object-fit: cover; }.image-wrap--3d { background: radial-gradient(circle at 50% 35%, #fff, #e8edf5 72%); box-shadow: 0 18px 42px #071a3d14; }.model-stage { position: relative; min-height: clamp(430px, 55vw, 650px); }.model-stage model-viewer { width: 100%; height: clamp(430px, 55vw, 650px); --poster-color: transparent; --progress-bar-color: var(--tiro-red); --progress-bar-height: 4px; }.model-guide { position: absolute; right: 18px; bottom: 18px; left: 18px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; pointer-events: none; }.model-guide span { display: inline-flex; min-height: 38px; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid #ffffff4d; border-radius: 999px; background: #071a3de8; color: white; font-size: .78rem; font-weight: 800; box-shadow: 0 8px 18px #071a3d26; backdrop-filter: blur(10px); }.model-guide b { color: #8bb7ff; font-size: 1.2rem; line-height: 1; }.mouse-icon { position: relative; width: 13px; height: 19px; border: 1.5px solid #8bb7ff; border-radius: 8px; }.mouse-icon::before { position: absolute; top: 3px; left: 50%; width: 2px; height: 4px; border-radius: 2px; background: #8bb7ff; content: ''; transform: translateX(-50%); }.image-note { position: absolute; right: 12px; bottom: 12px; padding: 6px 8px; border-radius: 7px; background: #071a3dcc; color: white; font-size: .72rem; }.details { max-width: 560px; }.details h1 { margin: 10px 0 16px; color: var(--tiro-navy); font-size: clamp(2.4rem, 4.5vw, 4rem); line-height: 1.04; letter-spacing: -.05em; }.badge { display: inline-block; padding: 6px 10px; border-radius: 999px; background: var(--tiro-red); color: white; font-size: .78rem; font-weight: 800; text-transform: uppercase; }.price-block { display: grid; gap: 6px; margin: 20px 0; }.price-block p { margin: 0; color: var(--tiro-grey); text-decoration: line-through; }.price-block strong { color: var(--tiro-red); font-size: 1.45rem; }.review-note { display: grid; gap: 4px; margin: 18px 0; padding: 14px; border-radius: 12px; background: #fff3e6; color: #723a00; font-size: .86rem; }.description { font-size: 1.08rem; }.detail-list { display: grid; gap: 10px; padding: 0; list-style: none; }.detail-list li { display: flex; gap: 10px; }.detail-list li::before { content: '✓'; color: var(--tiro-red); font-weight: 800; }.save-link { display: block; margin-top: 20px; color: var(--tiro-blue); font-size: .9rem; font-weight: 800; text-underline-offset: 5px; } @media (min-width: 880px) { .product-layout { grid-template-columns: 1.1fr .9fr; }.model-stage, .model-stage model-viewer { height: min(650px, calc(100vh - 170px)); min-height: 520px; } }
</style>
