---
import SiteLayout from '../../layouts/SiteLayout.astro';
const product = Astro.url.searchParams.get('product') ?? 'Product 01';
---
<SiteLayout title="Build your circle" description="Choose the people you would like to cover with TIRO.">
  <section class="circle-page section"><div class="container circle-shell"><a class="back-link" href="/cover/discover/">← Change my cover selection</a><div class="circle-heading"><p class="eyebrow">Build your circle</p><h1>Who would you like to include?</h1><p>You selected <strong>{product}</strong>. Add the people you would like TIRO to consider for cover. Final eligibility will be confirmed against the product rules.</p></div><div class="circle-layout"><section class="people-grid" aria-label="People to include"><button type="button" class="person active" data-person="You" aria-pressed="true"><span class="person-icon">You</span><strong>You</strong><small>Main member</small></button><button type="button" class="person" data-person="Partner" aria-pressed="false"><span class="person-icon">+1</span><strong>Partner</strong><small>Add if applicable</small></button><button type="button" class="person" data-person="Children" aria-pressed="false"><span class="person-icon">+2</span><strong>Children</strong><small>Add if applicable</small></button><button type="button" class="person" data-person="Mother" aria-pressed="false"><span class="person-icon">M</span><strong>Mother</strong><small>Add if eligible</small></button><button type="button" class="person" data-person="Father" aria-pressed="false"><span class="person-icon">F</span><strong>Father</strong><small>Add if eligible</small></button><button type="button" class="person" data-person="Extended family" aria-pressed="false"><span class="person-icon">+</span><strong>Extended family</strong><small>Add if eligible</small></button></section><aside class="circle-summary"><p class="summary-label">Your circle</p><h2 id="circle-count">Just you</h2><ul id="circle-list"><li>You</li></ul><p>TIRO will confirm eligibility and any premium changes when product rules are connected.</p><a class="button button-primary" id="circle-continue" href={`/cover/application/?product=${encodeURIComponent(product)}&circle=You`}>Continue to application <span aria-hidden="true">›</span></a><p class="underwriting">Tiro funeral cover is underwritten by KGA Life Insurance.</p></aside></div></div></section>
</SiteLayout>
<script define:vars={{ product }}>
  const people = Array.from(document.querySelectorAll('.person'));
  const list = document.querySelector('#circle-list');
  const count = document.querySelector('#circle-count');
  const continueLink = document.querySelector('#circle-continue');
  const selected = new Set(['You']);
  function render() {
    people.forEach((button) => { const enabled = selected.has(button.dataset.person); button.classList.toggle('active', enabled); button.setAttribute('aria-pressed', String(enabled)); });
    const names = Array.from(selected); list.innerHTML = names.map((name) => `<li>${name}</li>`).join('');
    count.textContent = names.length === 1 ? 'Just you' : `${names.length} people selected`;
    continueLink.href = `/cover/application/?product=${encodeURIComponent(product)}&circle=${encodeURIComponent(names.join(','))}`;
  }
  people.forEach((button) => button.addEventListener('click', () => { const person = button.dataset.person; if (person === 'You') return; selected.has(person) ? selected.delete(person) : selected.add(person); render(); }));
</script>
<style>
  .circle-page { min-height: 75vh; background: var(--tiro-soft-white); }.circle-shell { max-width: 1100px; }.back-link { display: inline-block; margin-bottom: 40px; color: var(--tiro-blue); font-weight: 800; text-underline-offset: 5px; }.circle-heading { max-width: 710px; }.circle-heading h1 { margin: 12px 0 16px; color: var(--tiro-navy); font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.06; letter-spacing: -.045em; }.circle-heading > p:not(.eyebrow) { font-size: 1.1rem; }.circle-layout { display: grid; gap: 24px; margin-top: 40px; align-items: start; }.people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }.person { min-height: 152px; display: grid; justify-items: start; align-content: start; gap: 6px; padding: 18px; border: 2px solid var(--tiro-light-grey); border-radius: 18px; background: white; color: var(--tiro-navy); text-align: left; cursor: pointer; transition: border-color 180ms, transform 180ms, box-shadow 180ms; }.person:hover { transform: translateY(-2px); border-color: #9bacbf; }.person.active { border-color: var(--tiro-blue); box-shadow: 0 0 0 3px #032e7618; }.person-icon { width: 42px; height: 42px; display: grid; place-items: center; margin-bottom: 4px; border-radius: 50%; background: var(--tiro-soft-white); color: var(--tiro-blue); font-size: .84rem; font-weight: 800; }.person.active .person-icon { background: var(--tiro-red); color: white; }.person strong { font-size: 1rem; }.person small { color: var(--tiro-grey); font-size: .78rem; }.circle-summary { padding: 28px; border: 1px solid var(--tiro-light-grey); border-radius: 24px; background: white; }.summary-label { margin: 0; color: var(--tiro-red); font-size: .8rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }.circle-summary h2 { margin: 10px 0 14px; color: var(--tiro-navy); font-size: 1.55rem; }.circle-summary ul { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }.circle-summary li { padding: 6px 10px; border-radius: 999px; background: var(--tiro-soft-white); color: var(--tiro-blue); font-size: .85rem; font-weight: 800; }.circle-summary > p:not(.summary-label, .underwriting) { color: var(--tiro-grey); font-size: .9rem; }.circle-summary .button { width: 100%; margin-top: 16px; }.underwriting { margin: 22px 0 0; color: var(--tiro-grey); font-size: .8rem; } @media (min-width: 760px) { .people-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } } @media (min-width: 1000px) { .circle-layout { grid-template-columns: 1fr 310px; }.circle-summary { position: sticky; top: 24px; } }
</style>
