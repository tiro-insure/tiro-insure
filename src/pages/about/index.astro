---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="About" description="Learn how TIRO Funeral Solutions has supported South African families since 2011.">
  <section class="about-overview section">
    <div class="container">
      <header class="about-page-heading">
        <p class="eyebrow">About TIRO</p>
        <h1>Founded in 2011, TIRO Funeral Solutions has provided cover and paid claims to thousands of families nationwide.</h1>
      </header>

      <article class="overview-card" data-overview-card>
        <div class="overview-card-copy">
          <p class="eyebrow">Our story</p>
          <div class="overview-story-copy">
            <p>In a time of grief, would you want to burden your family with the added stress of having to raise money to pay for a dignified funeral? Of course not.</p>
            <p>You do not need the added anxiety and confusion of the financial complications brought on by death.</p>
            <p>That is why we will be there for you in times of great sorrow with our funeral solutions = Money paid in 24 hours.</p>
            <p>Please visit one of our client walk in centers, where you get information about compliance, your rights as a consumer and what you need to know before you buy any insurance products.</p>
          </div>
          <a class="button button-secondary" href="#about-story">Our story <span aria-hidden="true">›</span></a>
        </div>
        <div class="overview-card-visual" data-overview-reveal>
          <img class="overview-chairman" src="/images/about/smiles.jpg" alt="Tiro Ratone, Executive Chairman" width="768" height="576" />
          <img class="overview-badge" src="/images/about/10years.png" alt="10 Years, 2011 to 2021" width="150" height="150" />
        </div>
      </article>
    </div>
  </section>

  <section class="customer-promise section">
    <div class="container">
      <div class="section-header promise-heading">
        <p class="eyebrow">Our customer promise</p>
        <h2 class="heading">Learning environments. Not selling platforms.</h2>
        <p>We have taken it upon ourselves to make our walk-in centers to be Learning environments...not selling platforms.</p>
      </div>

      <div class="promise-grid">
        <img class="promise-image promise-image--wide" src="/images/about/tiro-office.webp" alt="TIRO office" width="960" height="480" />

        <aside class="questions-card">
          <div class="questions-content">
            <p class="questions-label">Do you have any questions?</p>
            <p>Join thousands of South Africans that have trusted us for the past 10 years.</p>
            <a class="button" href="/branches/">View our branches</a>
          </div>
        </aside>

        <img class="promise-image" src="/images/about/tiro-service-vehicle.webp" alt="TIRO service vehicle" width="720" height="480" />
        <img class="promise-image" src="/images/about/tiro-branch.webp" alt="TIRO branch" width="720" height="480" />
      </div>
    </div>
  </section>

  <section class="about-hero section" id="about-story">
    <div class="container">
      <div class="about-bento">
        <article class="about-vision" aria-labelledby="about-vision-title">
          <a class="vision-video-link" href="https://www.youtube.com/watch?v=b1tkF7eJOBU" target="_blank" rel="noreferrer" aria-label="Watch TIRO 2031 vision on YouTube">
            <img src="https://i.ytimg.com/vi/b1tkF7eJOBU/hqdefault.jpg" alt="TIRO 2031 vision video" width="480" height="360" />
            <span class="vision-play" aria-hidden="true">▶</span>
          </a>
          <div class="about-vision-copy">
            <p class="eyebrow">2031 Vision</p>
            <h2 id="about-vision-title">Towards 2031 and beyond.</h2>
            <p>Watch the vision shaping our journey towards 2031 and beyond.</p>
            <a href="https://www.youtube.com/watch?v=b1tkF7eJOBU" target="_blank" rel="noreferrer">Watch on YouTube <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="story-card story-card--care">
          <span class="story-number">01</span>
          <h2>Here when it matters.</h2>
          <p>In a time of grief, would you want to burden your family with the added stress of having to raise money to pay for a dignified funeral? Of course not.</p>
          <p>You do not need the added anxiety and confusion of the financial complications brought on by a death.</p>
        </article>

        <article class="story-card story-card--support">
          <span class="story-number">02</span>
          <h2>Support you can reach.</h2>
          <p>We’re here in times of sorrow with funeral solutions and money paid in 24 hours.</p>
          <p>Visit a TIRO walk-in centre for guidance on compliance, your rights and choosing insurance products.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="updates section" aria-labelledby="updates-title">
    <div class="container">
      <div class="updates-heading">
        <p class="eyebrow">Updates</p>
        <h2 id="updates-title">What’s happening at TIRO</h2>
      </div>

      <div class="updates-grid">
        <article class="update-card">
          <img src="/images/about/premiums-update-placeholder.svg" alt="Placeholder for Pay@ premium payment update artwork" width="720" height="450" />
          <div class="update-content">
            <div class="update-meta"><time datetime="2026-04-16">April 16, 2026</time><span>Updates</span><span>0</span></div>
            <h3>Ensure your funeral policy premiums are always paid</h3>
            <p>Keeping your funeral policy active is one of the most important steps in ensuring your loved ones are protected when it matters most. Missed payments can lead to delays or even rejection of claims, something no family should have to face.</p>
            <a class="button button-secondary update-link" href="/learn/">Learn more <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <article class="update-card">
          <img src="/images/about/branches-update-placeholder.svg" alt="Placeholder for the TIRO branch opening event" width="720" height="450" />
          <div class="update-content">
            <div class="update-meta"><time datetime="2021-06-22">June 22, 2021</time><span>Branch Openings, Events</span><span>0</span></div>
            <h3>New branches opening soon</h3>
            <p>We are proud to announce the opening of 3 new branches in the next few months. Branches opening: Kagiso Mall – 31 July 2021, Mamelodi Mall – September 2021 and Hebron Mall – October 2022.</p>
            <a class="button button-secondary update-link" href="/branches/">Learn more <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <article class="update-card">
          <img src="/images/about/conference-update-placeholder.svg" alt="Placeholder for the TIRO 10 year celebration conference" width="720" height="450" />
          <div class="update-content">
            <div class="update-meta"><time datetime="2021-06-16">June 16, 2021</time><span>Updates</span><span>0</span></div>
            <h3>Our 10 year celebration conference</h3>
            <p>Highlights from our 10 Year Celebration Conference. “It is not easy doing it, we are going to do it because it is hard.”</p>
            <a class="button button-secondary update-link" href="/learn/">Learn more <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .about-overview { background: white; }
  .about-page-heading { margin-top: -60px; margin-bottom: clamp(30px, 4vw, 46px); }
  .about-page-heading .eyebrow { margin: 0 0 10px; }
  .about-page-heading h1 { max-width: 34ch; margin: 0; color: var(--tiro-navy); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 850; line-height: 1.12; letter-spacing: -.035em; }
  .overview-card { position: relative; display: grid; min-height: 300px; overflow: hidden; border: 1px solid #d9e2f0; border-radius: 24px; background: white; box-shadow: 0 12px 28px #071a3d0d; }
  .overview-card-copy { position: relative; z-index: 2; display: grid; align-content: center; justify-items: start; padding: clamp(28px, 4vw, 48px); }
  .overview-card-copy .eyebrow { margin: 0 0 10px; }
  .overview-story-copy { max-width: 62ch; margin-bottom: 20px; color: #38445a; }
  .overview-story-copy p { margin: 0; font-size: clamp(.78rem, 1.05vw, .9rem); line-height: 1.48; }
  .overview-story-copy p + p { margin-top: 7px; }
  .overview-card-copy .button { min-height: 42px; padding: 9px 15px; font-size: .84rem; }
  .overview-card-visual { position: relative; min-height: 220px; overflow: hidden; background: var(--tiro-navy); clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%); transition: clip-path 900ms cubic-bezier(.22, 1, .36, 1); }
  .overview-card-visual.is-revealed { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
  .overview-chairman { width: 100%; height: 100%; min-height: 220px; object-fit: cover; object-position: center; transform: scale(1.09); transition: transform 1200ms cubic-bezier(.22, 1, .36, 1); }
  .overview-card-visual.is-revealed .overview-chairman { transform: scale(1); }
  .overview-badge { position: absolute; z-index: 2; top: 20px; right: 20px; width: clamp(68px, 7.5vw, 94px); height: auto; opacity: 0; filter: drop-shadow(0 10px 16px #02081770); transform: translateY(-14px) scale(.82); transition: opacity 420ms ease 580ms, transform 620ms cubic-bezier(.22, 1, .36, 1) 580ms; }
  .overview-card-visual.is-revealed .overview-badge { opacity: 1; transform: translateY(0) scale(1); }

  .about-hero.section { padding-top: 53px; background: #071a3d; color: white; }
  .about-bento { display: grid; gap: 16px; }
  .about-bento > * { min-width: 0; border-radius: 24px; }

  .about-vision { display: grid; min-height: 300px; overflow: hidden; background: var(--tiro-navy); color: white; box-shadow: 0 18px 44px #071a3d12; }
  .vision-video-link { position: relative; display: block; min-height: 280px; overflow: hidden; background: #020817; }
  .vision-video-link::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, #071a3d80); content: ''; }
  .vision-video-link img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; transition: transform 240ms ease; }
  .vision-video-link:hover img { transform: scale(1.025); }
  .vision-play { position: absolute; z-index: 2; top: 50%; left: 50%; display: grid; width: clamp(56px, 7vw, 76px); height: clamp(56px, 7vw, 76px); place-items: center; border: 2px solid #ffffffb8; border-radius: 50%; background: var(--tiro-red); color: white; font-size: clamp(1rem, 2vw, 1.35rem); box-shadow: 0 14px 30px #071a3d4d; transform: translate(-50%, -50%); }
  .about-vision-copy { display: grid; align-content: center; justify-items: start; padding: clamp(26px, 3vw, 38px); }
  .about-vision-copy .eyebrow { margin: 0 0 10px; color: #9fc3ff; }
  .about-vision-copy h2 { max-width: 13ch; margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.35rem); line-height: 1; letter-spacing: -.045em; }
  .about-vision-copy > p:not(.eyebrow) { margin: 14px 0 20px; color: #dbe8ff; font-size: .9rem; }
  .about-vision-copy > a { color: white; font-size: .86rem; font-weight: 850; text-underline-offset: 5px; }

  .story-card { display: grid; min-height: 260px; align-content: start; padding: clamp(26px, 3vw, 36px); }
  .story-number { font-size: 1.35rem; font-weight: 850; }
  .story-card h2 { max-width: 15ch; margin: 22px 0 14px; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1; letter-spacing: -.04em; }
  .story-card p { margin: 0; font-size: .9rem; line-height: 1.6; }
  .story-card p + p { margin-top: 9px; }
  .story-card--care { background: #e8f0ff; color: var(--tiro-navy); }
  .story-card--care .story-number { color: var(--tiro-blue); }
  .story-card--support { background: var(--tiro-red); color: white; }
  .story-card--support .story-number { color: #ffd2d7; }
  .story-card--support a { display: inline-flex; width: fit-content; min-height: 42px; align-items: center; gap: 10px; margin-top: 22px; padding: 9px 15px; border: 1px solid #ffffff80; border-radius: 14px; color: white; font-size: .82rem; font-weight: 850; text-decoration: none; }
  .story-card--support a:hover { background: #ffffff16; }

  .customer-promise { background: var(--tiro-soft-white); }
  .promise-heading { max-width: 820px; margin-bottom: 36px; }
  .promise-heading .eyebrow { margin: 0 0 8px; }
  .promise-heading .heading { margin: 0; }
  .promise-heading > p { max-width: 640px; margin: 18px 0 0; color: #596579; font-size: 1.05rem; }
  .promise-grid { display: grid; gap: 16px; }
  .promise-image { width: 100%; height: 100%; min-height: 240px; border-radius: 24px; object-fit: cover; box-shadow: 0 14px 30px #071a3d0d; }
  .questions-card { min-height: 280px; padding: clamp(28px, 4vw, 44px); border-radius: 24px; background: var(--tiro-blue); color: white; box-shadow: 0 18px 44px #071a3d18; }
  .questions-content { display: grid; align-content: start; justify-items: start; }
  .questions-label { max-width: 13ch; margin: 0 0 16px; font-size: clamp(1.55rem, 2.8vw, 2.35rem); font-weight: 850; line-height: 1; letter-spacing: -.045em; }
  .questions-card p:not(.questions-label) { max-width: 32ch; margin: 0; color: #dbe8ff; line-height: 1.55; }
  .questions-card .button { margin-top: 26px; border-color: white; background: white; color: var(--tiro-red); }
  .questions-card .button:hover { border-color: white; background: #eef4ff; color: var(--tiro-red); }

  .updates { background: white; }
  .updates-heading { margin-bottom: 36px; }
  .updates-heading .eyebrow { margin: 0 0 8px; }
  .updates-heading h2 { max-width: 760px; margin: 0; color: var(--tiro-navy); font-size: clamp(2rem, 4vw, 3rem); font-weight: 850; line-height: 1.1; letter-spacing: -.035em; }
  .updates-grid { display: grid; gap: 16px; }
  .update-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--tiro-light-grey); border-radius: 24px; background: white; box-shadow: 0 12px 28px #071a3d0d; transition: transform 180ms ease, box-shadow 180ms ease; }
  .update-card:hover { transform: translateY(-3px); box-shadow: 0 18px 38px #071a3d16; }
  .update-card > img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; }
  .update-content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: clamp(24px, 3vw, 34px); }
  .update-meta { display: flex; flex-wrap: wrap; gap: 9px 18px; margin-bottom: 16px; color: #697386; font-size: .72rem; }
  .update-meta > * { display: inline-flex; align-items: center; gap: 6px; }
  .update-meta > *::before { width: 7px; height: 7px; border-radius: 50%; background: var(--tiro-blue); content: ''; }
  .update-meta span:nth-child(2)::before { border-radius: 1px; }
  .update-card h3 { margin: 0; color: var(--tiro-navy); font-size: clamp(1.35rem, 2.2vw, 1.8rem); font-weight: 850; line-height: 1.08; letter-spacing: -.04em; }
  .update-card p { margin: 14px 0 24px; color: #596579; font-size: .88rem; line-height: 1.65; }
  .update-link { min-height: 44px; margin-top: auto; padding: 9px 16px; font-size: .8rem; }

  @media (min-width: 760px) {
    .overview-card { grid-template-columns: minmax(0, 1.75fr) minmax(250px, .75fr); }
    .overview-card-visual { min-height: 100%; }
    .overview-card-visual.is-revealed { clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); }
    .about-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about-vision { grid-column: 1 / -1; }
    .promise-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .promise-image--wide { grid-column: 1 / -1; aspect-ratio: 2.5 / 1; }
    .updates-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .update-card:first-child { grid-column: 1 / -1; }
  }

  @media (min-width: 1040px) {
    .about-bento { grid-template-columns: minmax(0, 1.55fr) repeat(2, minmax(0, .72fr)); align-items: stretch; }
    .about-vision { position: relative; display: block; min-height: 340px; grid-column: 1; grid-row: 1; }
    .vision-video-link { position: absolute; inset: 0; min-height: 0; }
    .vision-video-link::after { z-index: 1; background: linear-gradient(180deg, transparent 28%, #071a3ded 100%); }
    .vision-video-link img { min-height: 0; }
    .about-vision-copy { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; padding: 26px 28px; pointer-events: none; }
    .about-vision-copy > p:not(.eyebrow) { display: none; }
    .about-vision-copy > a { margin-top: 12px; pointer-events: auto; }
    .about-vision-copy h2 { max-width: 18ch; font-size: 2rem; }
    .story-card { min-height: 340px; padding: 28px; }
    .story-card h2 { margin: 18px 0 12px; font-size: 1.65rem; }
    .story-card p { font-size: .8rem; line-height: 1.48; }
    .story-card--care { grid-column: 2; grid-row: 1; }
    .story-card--support { grid-column: 3; grid-row: 1; }
    .promise-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(245px, 1fr)); }
    .promise-image--wide { grid-column: 1 / span 2; grid-row: 1; aspect-ratio: auto; }
    .questions-card { position: relative; grid-column: 3; grid-row: 1 / span 2; }
    .questions-content { position: absolute; top: 44px; right: 44px; left: 44px; transform: translateY(var(--question-follow, 0)); }
    .promise-grid > .promise-image:nth-last-child(2) { grid-column: 1; grid-row: 2; }
    .promise-grid > .promise-image:last-child { grid-column: 2; grid-row: 2; }
    .update-card:first-child { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(340px, .8fr); }
    .update-card:first-child > img { height: 100%; aspect-ratio: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .update-card, .vision-video-link img, .overview-card-visual, .overview-chairman, .overview-badge { transition: none; }
    .overview-card-visual { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
    .overview-chairman, .overview-badge { transform: none; }
    .overview-badge { opacity: 1; }
    @media (min-width: 760px) {
      .overview-card-visual { clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); }
    }
  }
</style>

<script>
  const overviewVisual = document.querySelector<HTMLElement>('[data-overview-reveal]');
  const overviewCard = document.querySelector<HTMLElement>('[data-overview-card]');

  if (overviewVisual && overviewCard) {
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        overviewVisual.classList.add('is-revealed');
        observer.disconnect();
      }, { threshold: 0.2 });

      revealObserver.observe(overviewCard);
    } else {
      overviewVisual.classList.add('is-revealed');
    }
  }

  const questionCard = document.querySelector<HTMLElement>('.questions-card');
  const questionContent = questionCard?.querySelector<HTMLElement>('.questions-content');
  const desktopQuestions = window.matchMedia('(min-width: 1040px)');

  if (questionCard && questionContent) {
    let questionFrame: number | undefined;

    const updateQuestionPosition = () => {
      if (!desktopQuestions.matches) {
        questionContent.style.removeProperty('--question-follow');
        questionFrame = undefined;
        return;
      }

      const cardRect = questionCard.getBoundingClientRect();
      const padding = Number.parseFloat(getComputedStyle(questionCard).paddingTop);
      const availableTravel = Math.max(0, questionCard.clientHeight - questionContent.offsetHeight - (padding * 2));
      const requestedTravel = 110 - cardRect.top - padding;
      const travel = Math.min(availableTravel, Math.max(0, requestedTravel));

      questionContent.style.setProperty('--question-follow', `${travel}px`);
      questionFrame = undefined;
    };

    const requestQuestionUpdate = () => {
      if (questionFrame === undefined) questionFrame = window.requestAnimationFrame(updateQuestionPosition);
    };

    window.addEventListener('scroll', requestQuestionUpdate, { passive: true });
    window.addEventListener('resize', requestQuestionUpdate);
    desktopQuestions.addEventListener('change', requestQuestionUpdate);
    updateQuestionPosition();
  }
</script>
