  .steps, .benefits { display: grid; gap: 16px; margin-top: 32px; }
  .steps .card { display: grid; align-content: center; min-height: 190px; padding: 24px 28px; border: 1px solid #ffffff3b; border-radius: 15px; background: linear-gradient(135deg, #122f61, #1d447d); color: white; box-shadow: 0 14px 30px #071a3d14; }
  .benefits .card { padding: 28px; }
  .benefits h3 { margin: 0 0 8px; color: var(--tiro-navy); font-size: 1.25rem; }
  .benefits p { margin: 0; }
  .steps span { color: #ff5a69; font-size: 1.5rem; font-weight: 800; }
  .steps h3 { margin: 16px 0 8px; color: white; font-size: 1.4rem; }
  .steps p { margin: 0; color: #dbe8ff; }
