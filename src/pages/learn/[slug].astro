---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { articles, type Article } from '../../data/articles';

export const prerender = true;
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
interface Props { article: Article; }
const { article } = Astro.props;
const published = new Intl.DateTimeFormat('en-ZA', { dateStyle: 'long' }).format(new Date(`${article.publishedAt}T00:00:00`));
---
<SiteLayout title={article.title} description={article.description}>
  <article class="article section"><div class="container"><a class="back-link" href="/learn/">← Back to Learn</a><header><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lede">{article.description}</p><p class="meta">Published {published} · {article.readTime}</p></header><div class="article-body">{article.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}<aside class="article-cta"><p class="eyebrow">Explore TIRO</p><h2>Ready for the next step?</h2><a class="button button-primary" href={article.cta.href}>{article.cta.label} <span aria-hidden="true">›</span></a></aside></div></div></article>
</SiteLayout>
<style>
  .article { background: white; }.article > .container { max-width: 850px; }.back-link { display: inline-block; margin-bottom: 42px; color: var(--tiro-blue); font-weight: 800; text-underline-offset: 5px; }.article header { max-width: 760px; }.article h1 { margin: 12px 0 18px; color: var(--tiro-navy); font-size: clamp(2.6rem, 5vw, 4.25rem); line-height: 1.04; letter-spacing: -.05em; }.lede { font-size: clamp(1.1rem, 2vw, 1.28rem); }.meta { color: var(--tiro-grey); font-size: .86rem; }.article-body { max-width: 700px; margin-top: 54px; }.article-body section { margin-bottom: 42px; }.article-body h2 { margin: 0 0 14px; color: var(--tiro-navy); font-size: clamp(1.55rem, 3vw, 2rem); line-height: 1.15; }.article-body p { font-size: 1.06rem; }.article-cta { margin-top: 56px; padding: 28px; border-radius: 22px; background: var(--tiro-soft-white); }.article-cta h2 { margin-top: 8px; }.article-cta .button { margin-top: 8px; }
</style>
