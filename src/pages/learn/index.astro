---
import SiteLayout from '../../layouts/SiteLayout.astro';

const questions = [
  { category: 'Funeral cover', question: 'How does funeral cover work?', answer: 'Funeral cover is designed to provide financial support when a covered person passes away. Start by considering the people you want to protect and the cover amount that suits your needs.', href: '/learn/how-funeral-cover-works/', link: 'Read the guide' },
  { category: 'Funeral cover', question: 'Who can I include in my cover?', answer: 'Depending on the product rules, you may be able to include yourself, a partner, children, parents and extended family. Confirm the available options before applying.' },
  { category: 'Funeral cover', question: 'What should I compare before choosing cover?', answer: 'Look at the cover amount, monthly premium, waiting periods, exclusions and who can be added. The product terms should be clear before you decide.' },
  { category: 'Tombstones', question: 'How do I choose a tombstone?', answer: 'Start with the cemetery requirements and the space available, then choose a memorial that feels right for the tribute you have in mind.', href: '/learn/how-to-choose-a-tombstone/', link: 'Read the guide' },
  { category: 'Tombstones', question: 'What does a tombstone price include?', answer: 'Ask for a clear breakdown of the selected memorial, personalisation, delivery, installation and any extras before you place an order.' },
  { category: 'Tombstones', question: 'Can I personalise a memorial?', answer: 'Inscriptions, portrait options and decorative details can be discussed once you have selected a suitable base design.' },
  { category: 'Claims', question: 'What should I prepare for a funeral claim?', answer: 'Keep the policy number, insurer contact details and policyholder information somewhere a trusted person can find them.', href: '/learn/what-to-prepare-for-a-funeral-claim/', link: 'Read the guide' },
  { category: 'Claims', question: 'How quickly are claims paid?', answer: 'TIRO aims to pay qualifying claims within 24 hours once the required information has been received and approved. Ask TIRO to confirm the current process for your policy.' },
  { category: 'Support', question: 'Can I speak to someone in person?', answer: 'Yes. TIRO combines online convenience with face-to-face help. You can find a nearby branch when you would prefer to speak with a person.' },
];
const columns = [questions.slice(0, 3), questions.slice(3, 6), questions.slice(6, 9)];
---
<SiteLayout title="Learn | TIRO" description="Plain-language answers about funeral cover, tombstones, claims and TIRO support.">
  <section class="learn-hero section"><div class="container"><figure class="learn-testimonial"><div class="learn-avatar-wrap" aria-hidden="true"><span class="mask-line mask-line-left"></span><span class="mask-line mask-line-right"></span><span class="mask-line mask-line-top"></span><span class="mask-line mask-line-bottom"></span><img src="https://cdn.21st.dev/assets/mirror/51/513d06f542692036ff0bb17938f04b3efd60567ba2cae08049469d21f18e0524.jpg" alt="" /></div><figcaption><p class="eyebrow">Learn</p><h1>Useful answers, in plain language.</h1><p>Browse clear answers about funeral cover, tombstones, claims and support before you need to make a decision.</p></figcaption></figure></div></section>
  <nav class="learn-topics" aria-label="Learn topics"><div class="container topic-grid"><a class="topic-card topic-cover" href="#funeral-cover"><span class="topic-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8.5 8 9 4.6-.5 8-4 8-9V6z" /></svg><strong>Funeral cover</strong></span><b aria-hidden="true"><img src="/brand/tiro-chevron.svg" alt="" /></b></a><a class="topic-card topic-tombstones" href="#tombstones"><span class="topic-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 21V11a5 5 0 0 1 10 0v10M5 21h14" /></svg><strong>Tombstones</strong></span><b aria-hidden="true"><img src="/brand/tiro-chevron.svg" alt="" /></b></a><a class="topic-card topic-claims" href="#claims"><span class="topic-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h6" /></svg><strong>Claims</strong></span><b aria-hidden="true"><img src="/brand/tiro-chevron.svg" alt="" /></b></a></div></nav>
  <section class="question-library section" aria-label="TIRO question and answer library"><div class="container question-columns">{columns.map((column, index) => <div id={['funeral-cover', 'tombstones', 'claims'][index]} class:list={['question-column', `question-column-${index + 1}`]}><div class="question-column-track">{[...column, ...column].map((item) => <article class="question-card"><p>{item.category}</p><h3>{item.question}</h3><span>{item.answer}</span>{item.href && <a href={item.href}>{item.link} <b aria-hidden="true">›</b></a>}</article>)}</div></div>)}</div></section>
  <section class="ask-section section" aria-labelledby="ask-heading"><div class="container ask-layout"><div><p class="eyebrow">Ask TIRO</p><h2 id="ask-heading">Have a knowledge question?</h2><p>Tell us what you would like explained. Your question helps us build a more useful Learn library for families.</p><p class="ask-note">Please do not include policy numbers, ID numbers or other personal information here. For help with a policy or claim, talk to TIRO directly.</p></div><form class="question-form" data-question-form><label for="question-topic">Topic</label><select id="question-topic" name="topic"><option>Funeral cover</option><option>Tombstones</option><option>Claims</option><option>Branches and support</option><option>Something else</option></select><label for="question-text">Your question</label><textarea id="question-text" name="question" rows="5" required placeholder="What would you like to know?"></textarea><button class="button button-primary" type="submit">Submit a question <span aria-hidden="true">›</span></button><p class="form-response" data-question-response role="status" aria-live="polite"></p></form></div></section>
</SiteLayout>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-question-form]').forEach((form) => {
    const response = form.querySelector<HTMLElement>('[data-question-response]');
    form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity()) return; if (response) response.textContent = 'Thank you. Your question has been noted for the TIRO Learn library.'; form.reset(); });
  });
</script>
<style>
  .learn-hero { background: white; }.learn-testimonial { width: min(100%, 512px); margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; }.learn-avatar-wrap { position: relative; width: 96px; height: 96px; flex: 0 0 auto; }.learn-avatar-wrap img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; mask-image: radial-gradient(circle, black 60%, transparent); }.mask-line { position: absolute; z-index: -1; background: #071a3d33; }.mask-line-left, .mask-line-right { top: -50%; bottom: -50%; width: 1px; mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent); }.mask-line-left { left: 0; }.mask-line-right { right: 0; }.mask-line-top, .mask-line-bottom { right: -50%; left: -50%; height: 1px; mask-image: linear-gradient(to right, transparent, black 20%, black 80%, transparent); }.mask-line-top { top: 0; }.mask-line-bottom { bottom: 0; }.learn-testimonial figcaption { padding: 32px; text-align: center; }.learn-testimonial .eyebrow { margin-bottom: 12px; }.learn-hero h1 { margin: 0; color: var(--tiro-navy); font-size: clamp(2rem, 4vw, 2.7rem); line-height: 1.06; letter-spacing: -.045em; }.learn-testimonial figcaption > p:last-child { margin: 16px 0 0; color: var(--tiro-grey); font-size: 1.05rem; line-height: 1.45; }
  .learn-topics { padding-bottom: 28px; }.topic-grid { display: grid; gap: 14px; }.topic-card { display: flex; min-height: 128px; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-radius: 20px; color: white; text-decoration: none; box-shadow: 0 14px 30px #071a3d1c; transition: transform 180ms ease, box-shadow 180ms ease; }.topic-card:hover { transform: translateY(-3px); box-shadow: 0 19px 34px #071a3d2b; }.topic-cover { background: linear-gradient(135deg, #1763d8, #0c3f91); }.topic-tombstones { background: linear-gradient(135deg, #f13244, #b9081c); }.topic-claims { background: linear-gradient(135deg, #153568, #071a3d); }.topic-name { display: inline-flex; align-items: center; gap: 12px; font-size: clamp(1.18rem, 2vw, 1.5rem); }.topic-name svg { width: 25px; height: 25px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }.topic-card > b { display: grid; width: 58px; height: 58px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: white; color: var(--tiro-blue); font-size: 1.7rem; font-weight: 400; }.question-column { scroll-margin-top: 28px; }
  .question-library { margin-top: -85px; }.question-columns { display: grid; gap: 18px; max-height: 670px; overflow: hidden; mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent); }.question-column { overflow: hidden; }.question-column-track { display: grid; align-content: start; gap: 18px; animation: question-column-scroll 25s linear infinite; }.question-column-2 .question-column-track { animation-duration: 31s; animation-direction: reverse; }.question-column-3 .question-column-track { animation-duration: 28s; }.question-column:hover .question-column-track, .question-column:focus-within .question-column-track { animation-play-state: paused; }.question-card { display: grid; align-content: start; min-height: 194px; gap: 13px; padding: 25px; border: 1px solid var(--tiro-light-grey); border-radius: 20px; background: white; box-shadow: 0 12px 20px #071a3d12; }.question-card > p { margin: 0; color: var(--tiro-red); font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }.question-card h3 { margin: 0; color: var(--tiro-navy); font-size: 1.25rem; line-height: 1.15; }.question-card > span { color: var(--tiro-charcoal); font-size: .92rem; line-height: 1.55; }.question-card a { margin-top: auto; color: var(--tiro-blue); font-size: .9rem; font-weight: 800; text-underline-offset: 4px; }.question-card b { font-size: 1.1rem; } @keyframes question-column-scroll { to { transform: translateY(calc(-50% - 9px)); } }
  .ask-section { background: var(--tiro-navy); color: white; }.ask-layout { display: grid; gap: 36px; }.ask-layout .eyebrow { color: #bcd5ff; }.ask-layout h2 { max-width: 12ch; margin: 10px 0 16px; color: white; font-size: clamp(2.25rem, 4vw, 3.65rem); line-height: 1; letter-spacing: -.05em; }.ask-layout > div > p:not(.eyebrow) { max-width: 530px; color: #dbe8ff; font-size: 1.08rem; }.ask-note { font-size: .9rem !important; }.question-form { display: grid; gap: 9px; max-width: 560px; padding: 24px; border: 1px solid #ffffff38; border-radius: 20px; background: #ffffff0b; }.question-form label { color: #dbe8ff; font-size: .86rem; font-weight: 800; }.question-form select, .question-form textarea { width: 100%; padding: 12px 14px; border: 1px solid #ffffff60; border-radius: 10px; background: white; color: var(--tiro-navy); font: inherit; }.question-form textarea { resize: vertical; }.question-form .button { justify-self: start; margin-top: 8px; }.form-response { min-height: 1.4em; margin: 2px 0 0; color: #bcd5ff; font-size: .9rem; }
  @media (min-width: 720px) { .learn-testimonial { display: grid; grid-template-columns: auto 1fr; align-items: center; transform: translate(-370px, -30px); }.learn-avatar-wrap { width: 128px; height: 128px; }.learn-testimonial figcaption { padding: 24px; text-align: left; }.topic-grid { grid-template-columns: repeat(3, 1fr); }.topic-card { min-height: 164px; padding: 24px; }.question-columns { grid-template-columns: repeat(2, 1fr); } } @media (min-width: 1020px) { .question-columns { grid-template-columns: repeat(3, 1fr); } .ask-layout { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: start; } } @media (prefers-reduced-motion: reduce) { .question-column-track { animation: none; }.question-columns { max-height: none; mask-image: none; } }
  .learn-avatar-wrap img { position: relative; z-index: 1; }
  .mask-line { z-index: 0; }
  .mask-line-left, .mask-line-right { top: -85%; bottom: -85%; }
  .mask-line-top, .mask-line-bottom { right: auto; left: 0; width: 576px; }
  .learn-avatar-wrap::before, .learn-avatar-wrap::after { position: absolute; z-index: 0; left: -92px; width: 92px; height: 1px; content: ''; background: #071a3d33; mask-image: linear-gradient(to right, transparent, black); }
  .learn-avatar-wrap::before { top: 0; }
  .learn-avatar-wrap::after { bottom: 0; }
  .topic-card { min-height: 74px; padding: 16px 20px; border-radius: 14px; }
  .topic-name { gap: 9px; font-size: 1.12rem; }
  .topic-name svg { width: 20px; height: 20px; }
  .topic-card > b { width: 38px; height: 38px; }
  .topic-card > b img { width: 10px; height: 17px; object-fit: contain; transform: rotate(90deg); }
</style>
