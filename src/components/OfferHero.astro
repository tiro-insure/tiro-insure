---
interface Props {
  id?: string;
  eyebrow?: string;
  headingLead?: string;
  headingMiddle?: string;
  headingHighlight?: string;
  lead?: string;
  highlightPrimary?: { label: string; value: string; sub: string };
  highlightSecondary?: { label: string; value: string; sub: string };
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  note?: string;
  badgeRect?: { label: string; value: string; sub: string };
  badgeCircle?: { label: string; value: string; sub: string };
  posterImage?: { src: string; position: string; size: string };
  accent?: string;
  headingSize?: string;
  showOutline?: boolean;
  posterFramed?: boolean;
  showPoster?: boolean;
}

const {
  id = 'offer-heading',
  eyebrow = 'People today. Brighter tomorrows.',
  headingLead = 'Affordable funeral cover',
  headingMiddle,
  headingHighlight = 'from R60 a month.',
  lead = 'Protection for you, your family and extended family—with a simple journey and real support when it matters.',
  highlightPrimary = { label: 'Get up to', value: 'R35 000', sub: 'funeral cover' },
  highlightSecondary = { label: 'Plus', value: 'R500', sub: 'airtime' },
  primaryCta = { label: 'Find my cover', href: '/cover/discover/' },
  secondaryCta = { label: 'Explore funeral cover', href: '/cover/' },
  note = 'Promotional offer subject to TIRO terms, eligibility and policy conditions. TIRO funeral cover is underwritten by KGA Life Insurance.',
  badgeRect = { label: 'Get up to', value: 'R35 000', sub: 'cover for your whole circle' },
  badgeCircle = { label: 'Plus', value: 'R500', sub: 'airtime' },
  posterImage = { src: '/brand/campaigns/a_clean_grid_style_advertisement_poster_layout_s.png', position: '100% 0%', size: '318% 200%' },
  accent,
  headingSize,
  showOutline = true,
  posterFramed = true,
  showPoster = true,
} = Astro.props as Props;

const posterStyle = `--poster-image:url('${posterImage.src}');--poster-position:${posterImage.position};--poster-size:${posterImage.size};`;
let rootStyle = accent ? `--accent-text:${accent};--accent-badge:${accent};` : '';
if (headingSize) rootStyle += `--heading-size:${headingSize};`;
---

<section class:list={['offer-hero', { 'offer-hero--tombstones': id === 'tombstone-offer-heading' }]} aria-labelledby={id} style={rootStyle}>
  <div class="container offer-grid">
    <div class="offer-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id={id}><span class:list={['heading-lead', { 'heading-lead--no-wrap': id === 'tombstone-offer-heading' }]}>{headingLead}</span>{headingMiddle && <span class="heading-middle">{headingMiddle}</span>}<span>{headingHighlight}</span></h1>
      <p class="offer-lead">{lead}</p>
      <div class="offer-highlights" aria-label="Current cover offer highlights">
        <div><span>{highlightPrimary.label}</span><strong>{highlightPrimary.value}</strong><span>{highlightPrimary.sub}</span></div>
        <div><span>{highlightSecondary.label}</span><strong>{highlightSecondary.value}</strong><span>{highlightSecondary.sub}</span></div>
      </div>
      <div class="offer-actions">
        <a class="button button-primary" href={primaryCta.href}>{primaryCta.label} <span aria-hidden="true">›</span></a>
        <a class="offer-link" href={secondaryCta.href}>{secondaryCta.label} <span aria-hidden="true">›</span></a>
      </div>
      <p class="offer-note">{note}</p>
    </div>
    <div class="offer-visual" aria-hidden="true">
      {showOutline && <div class="offer-outline"></div>}
      {showPoster && <div class={`campaign-poster${posterFramed ? '' : ' campaign-poster--frameless'}`} style={posterStyle}></div>}
      <div class="cover-amount"><span>{badgeRect.label}</span><strong>{badgeRect.value}</strong><span>{badgeRect.sub}</span></div>
      <div class="airtime-badge"><span>{badgeCircle.label}</span><strong>{badgeCircle.value}</strong><span>{badgeCircle.sub}</span></div>
    </div>
  </div>
</section>

<style>
  .offer-hero { position: relative; overflow: hidden; padding: clamp(9px, calc(8vw - 65px), 53px) 0 45px; background: linear-gradient(120deg, #071a3d 0%, #082a66 58%, #0a3f88 100%); color: white; }
  .offer-hero::after { content: ''; position: absolute; inset: auto -12% -55% auto; width: min(56vw, 880px); height: min(56vw, 880px); border: 1px solid #ffffff24; border-radius: 50%; }
  .offer-grid { position: relative; z-index: 1; display: grid; align-items: center; gap: clamp(42px, 6vw, 84px); }
  .offer-copy { max-width: 700px; }
  .offer-hero .eyebrow { color: #e7efff; }
  .offer-hero h1 { max-width: 820px; margin: 14px 0 22px; color: white; font-size: var(--heading-size, clamp(3rem, 6.2vw, 5.45rem)); line-height: .96; letter-spacing: -.07em; }
  .offer-hero h1 span { display: block; color: var(--accent-text, #ff3144); white-space: pre-line; }
  .offer-hero h1 > span:last-child { margin-top: 7px; }
  .offer-hero h1 span.heading-lead,
  .offer-hero h1 span.heading-middle { color: #fff !important; }
  .offer-hero--tombstones .offer-copy { max-width: 900px; }
  .offer-hero:not(.offer-hero--tombstones) { padding-bottom: 33px; }
  .offer-hero--tombstones { padding-bottom: 67px; }
  .offer-hero--tombstones h1 { max-width: 900px; }
  .offer-hero--tombstones .offer-lead { max-width: 680px; }
  .offer-hero--tombstones h1 .heading-lead--no-wrap { white-space: nowrap; }
  .offer-lead { max-width: 590px; margin: 0; color: #f0f5ff; font-size: clamp(1.08rem, 1.7vw, 1.28rem); }
  .offer-highlights { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .offer-highlights > div { display: grid; align-content: center; min-width: 170px; min-height: 104px; padding: 16px 20px; border: 1px solid #ffffff3b; border-radius: 15px; background: #ffffff12; backdrop-filter: blur(8px); }
  .offer-highlights span { color: #dbe8ff; font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .offer-highlights strong { color: white; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1.05; }
  .offer-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 30px; }
  .offer-actions .button-primary { background: var(--accent-text, var(--tiro-red)); }
  .offer-actions .button-primary:hover { background: var(--accent-text, var(--tiro-red)); filter: brightness(0.88); }
  .offer-link { color: white; font-weight: 800; text-decoration: underline; text-decoration-color: #ed1b2f; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .offer-note { max-width: 630px; margin: 22px 0 0; color: #cbd8eb; font-size: .76rem; line-height: 1.45; }
  .offer-visual { position: relative; min-height: 500px; transform: translateY(-70px) scale(.85); transform-origin: top center; }
  .offer-hero--tombstones .offer-visual { transform: translateY(-65px) scale(.85); }
  .offer-outline { position: absolute; inset: 7% 3% 4% 13%; border: 2px solid #ffffffa6; border-radius: 24px; }
  .campaign-poster { position: absolute; z-index: 2; top: 5%; right: 7%; width: min(54%, 295px); aspect-ratio: .43; border: 5px solid white; border-radius: 18px; background: var(--poster-image) var(--poster-position) / var(--poster-size) no-repeat; box-shadow: 0 28px 56px #0006; transform: rotate(3deg); }
  .campaign-poster--frameless { border: 0; border-radius: 0; box-shadow: none; }
  .cover-amount { position: absolute; z-index: 3; bottom: 8%; left: 0; display: grid; padding: 20px 24px; border-radius: 18px; background: var(--accent-badge, #ed1b2f); box-shadow: 0 18px 38px #0004; transform: rotate(-3deg); }
  .offer-hero:not(.offer-hero--tombstones) .cover-amount { transform: translate(-90px, 25px) rotate(-3deg) scale(.85); transform-origin: center; }
  .cover-amount span { font-size: .8rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .cover-amount strong { font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: .95; letter-spacing: -.06em; }
  .airtime-badge { position: absolute; z-index: 4; top: 31%; left: 1%; display: grid; width: 128px; height: 128px; place-content: center; border: 4px solid white; border-radius: 50%; background: var(--accent-badge, #ed1b2f); text-align: center; box-shadow: 0 15px 30px #0004; transform: rotate(-11deg); }
  .airtime-badge span { font-size: .76rem; font-weight: 800; line-height: 1; text-transform: uppercase; }
  .airtime-badge strong { font-size: 2.1rem; line-height: 1.05; }
  @media (min-width: 940px) { .offer-grid { grid-template-columns: minmax(0, 1.1fr) minmax(390px, .9fr); } }
  @media (max-width: 939px) { .offer-visual { max-width: 540px; width: 100%; margin-inline: auto; min-height: 420px; } }
  @media (max-width: 560px) { .offer-visual { min-height: 350px; } .campaign-poster { width: 48%; } .cover-amount { padding: 15px 17px; } .airtime-badge { width: 102px; height: 102px; } .airtime-badge strong { font-size: 1.7rem; } }
</style>
