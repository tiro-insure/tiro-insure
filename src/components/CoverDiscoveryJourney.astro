---
const circleOptions = [
  { value: 'myself', label: 'Just me', detail: 'Cover for one person.' },
  { value: 'partner', label: 'Me + partner', detail: 'Cover for you and your partner.' },
  { value: 'family', label: 'My family', detail: 'Include your children where eligible.' },
  { value: 'extended', label: 'Extended family', detail: 'Build a wider circle where eligible.' },
];
const coverOptions = ['R10,000 – R20,000', 'R20,000 – R35,000', 'R35,000 – R50,000', 'I want to compare'];
const budgetOptions = ['Up to R100', 'R100 – R250', 'R250 – R500', 'I want to compare'];
---

<div class="cover-discovery" id="find-cover">
  <div class="progress" aria-label="Cover discovery progress"><span class="progress-line"></span><span class="progress-dot active" data-progress="1">1</span><span class="progress-dot" data-progress="2">2</span><span class="progress-dot" data-progress="3">3</span><span class="progress-dot" data-progress="4">4</span></div>
  <form data-cover-discovery novalidate>
    <fieldset class="step active" data-step="1"><legend>Who do you want to cover?</legend><p class="step-help">Choose the option closest to your needs.</p><div class="choice-grid">{circleOptions.map((option) => <label class="choice-card"><input type="radio" name="circle" value={option.value} /><span><strong>{option.label}</strong><small>{option.detail}</small></span><i aria-hidden="true">→</i></label>)}</div></fieldset>
    <fieldset class="step" data-step="2"><legend>How much cover are you looking for?</legend><p class="step-help">You can compare options if you’re still deciding.</p><div class="choice-grid compact">{coverOptions.map((option) => <label class="choice-card"><input type="radio" name="cover" value={option} /><span><strong>{option}</strong></span><i aria-hidden="true">→</i></label>)}</div></fieldset>
    <fieldset class="step" data-step="3"><legend>What’s your monthly budget?</legend><p class="step-help">This helps us organise your options. It is not financial advice.</p><div class="choice-grid compact">{budgetOptions.map((option) => <label class="choice-card"><input type="radio" name="budget" value={option} /><span><strong>{option}</strong></span><i aria-hidden="true">→</i></label>)}</div></fieldset>
    <section class="step results" data-step="4" aria-live="polite"><p class="eyebrow">Your starting point</p><h2>These options match the information you selected.</h2><p>Final pricing, eligibility and policy terms will appear here when TIRO’s product data is connected.</p><div class="result-grid"><article class="result-card"><span class="tag">Product 01</span><h3>Cover for your circle</h3><p>Product details will be confirmed by TIRO.</p><button type="button" class="button button-primary" data-select-product="Product 01">Choose this cover <span aria-hidden="true">›</span></button></article><article class="result-card"><span class="tag neutral">Product 02</span><h3>Compare another option</h3><p>Review cover amounts, dependants and policy terms once available.</p><button type="button" class="button button-secondary" data-select-product="Product 02">Compare cover <span aria-hidden="true">›</span></button></article></div><aside class="underwriting-note">Tiro funeral cover is underwritten by KGA Life Insurance.</aside></section>
    <div class="form-actions"><button type="button" class="button button-secondary" data-previous hidden>Back</button><button type="button" class="button button-primary" data-next>Continue <span aria-hidden="true">›</span></button></div>
    <p class="form-error" role="alert" hidden>Please choose an option to continue.</p>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cover-discovery]').forEach((form) => {
    const next = form.querySelector<HTMLButtonElement>('[data-next]'); const previous = form.querySelector<HTMLButtonElement>('[data-previous]'); const error = form.querySelector<HTMLElement>('.form-error');
    if (!next || !previous || !error) return;
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.step')); const dots = Array.from(form.closest('.cover-discovery')?.querySelectorAll<HTMLElement>('.progress-dot') ?? []); let current = 1; const fields: Record<number, string> = { 1: 'circle', 2: 'cover', 3: 'budget' };
    const render = () => { steps.forEach((step) => step.classList.toggle('active', Number(step.dataset.step) === current)); dots.forEach((dot) => dot.classList.toggle('active', Number(dot.dataset.progress) <= current)); previous.hidden = current === 1; next.hidden = current === 4; error.hidden = true; form.querySelector<HTMLElement>(`[data-step="${current}"] legend, [data-step="${current}"] h2`)?.focus(); };
    next.addEventListener('click', () => { if (!form.querySelector(`input[name="${fields[current]}"]:checked`)) { error.hidden = false; return; } current += 1; render(); }); previous.addEventListener('click', () => { current -= 1; render(); }); form.querySelectorAll<HTMLButtonElement>('[data-select-product]').forEach((button) => button.addEventListener('click', () => { window.location.href = `/cover/circle/?product=${encodeURIComponent(button.dataset.selectProduct ?? 'Product 01')}`; }));
  });
</script>

<style>
  .cover-discovery { margin-top: clamp(40px, 6vw, 72px); }.progress { position: relative; display: flex; justify-content: space-between; max-width: 640px; margin: 0 0 40px; }.progress-line { position: absolute; top: 20px; left: 20px; right: 20px; height: 2px; background: var(--tiro-light-grey); }.progress-dot { position: relative; z-index: 1; width: 42px; height: 42px; display: grid; place-items: center; border: 2px solid var(--tiro-light-grey); border-radius: 50%; background: white; color: var(--tiro-grey); font-weight: 800; }.progress-dot.active { border-color: var(--tiro-red); background: var(--tiro-red); color: white; }.step { display: none; max-width: 960px; margin: 0; padding: 0; border: 0; }.step.active { display: block; } legend, .results h2 { max-width: 800px; color: var(--tiro-navy); font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1.12; letter-spacing: -.035em; }.step-help { margin: 12px 0 24px; color: var(--tiro-grey); font-size: 1.05rem; }.choice-grid { display: grid; gap: 14px; }.choice-card { min-height: 104px; display: flex; align-items: center; gap: 16px; padding: 20px; border: 2px solid var(--tiro-light-grey); border-radius: 18px; background: white; color: var(--tiro-navy); cursor: pointer; }.choice-card:has(input:checked) { border-color: var(--tiro-blue); box-shadow: 0 0 0 3px #032e7615; }.choice-card input { width: 22px; height: 22px; accent-color: var(--tiro-red); flex: 0 0 auto; }.choice-card span { display: grid; gap: 4px; }.choice-card strong { font-size: 1.08rem; }.choice-card small { color: var(--tiro-grey); font-size: .92rem; }.choice-card i { margin-left: auto; color: var(--tiro-red); font-size: 1.5rem; font-style: normal; }.form-actions { display: flex; gap: 12px; margin-top: 30px; }.form-error { color: #a31220; font-weight: 700; }.results > p { max-width: 680px; font-size: 1.05rem; }.result-grid { display: grid; gap: 16px; margin-top: 28px; }.result-card { padding: 28px; border: 1px solid var(--tiro-light-grey); border-radius: 24px; background: white; }.tag { display: inline-block; padding: 5px 10px; border-radius: 999px; background: var(--tiro-red); color: white; font-size: .8rem; font-weight: 800; }.tag.neutral { background: var(--tiro-light-grey); color: var(--tiro-blue); }.result-card h3 { margin: 16px 0 8px; color: var(--tiro-navy); font-size: 1.4rem; }.result-card .button { margin-top: 16px; }.underwriting-note { margin-top: 24px; color: var(--tiro-grey); font-size: .86rem; } @media (min-width: 700px) { .choice-grid, .choice-grid.compact, .result-grid { grid-template-columns: repeat(2, 1fr); } }
</style>