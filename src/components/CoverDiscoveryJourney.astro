                <div class="payment-fields">
                  <label><span>Payment type <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18M7 15h4"></path></svg><select name="paymentType" required><option>Debit Order</option></select></span></label>
                  <label><span>Bank name <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-6 9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 21h18M2 18h20"></path></svg><select name="bankName" required><option value="">Select bank</option><option>ABSA</option><option>Capitec</option><option>FNB</option><option>Nedbank</option><option>Standard Bank</option><option>African Bank</option><option>TymeBank</option><option>Other</option></select></span></label>
                  <label><span>Account holder name <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-5 3-8 8-8s8 3 8 8"></path></svg><input type="text" name="accountHolder" placeholder="Account holder name" autocomplete="name" required /></span></label>
                  <label><span>Bank account number <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18M7 15h4"></path></svg><input type="text" name="bankAccountNumber" placeholder="Bank account number" inputmode="numeric" pattern="[0-9]{6,16}" maxlength="16" title="Enter a valid bank account number" required /></span></label>
                  <label><span>Account type <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"></path><circle cx="4" cy="6" r="1"></circle><circle cx="4" cy="12" r="1"></circle><circle cx="4" cy="18" r="1"></circle></svg><select name="accountType" required><option value="">Select account type</option><option>Cheque / Current</option><option>Savings</option><option>Transmission</option></select></span></label>
