---
const planGroups = [
  {
    value: 'member-only', label: 'Member Only', detail: 'Cover for yourself.', image: '/images/about/member_only.png',
    linkedMembers: [{ value: 'spouse', label: 'Spouse', max: 1 }],
    plans: [
      { name: 'Member Only A', cover: 'R8,000', premium: 'R115 per month' },
      { name: 'Member Only B', cover: 'R10,000', premium: 'R135 per month' },
      { name: 'Member Only C', cover: 'R15,000', premium: 'R170 per month' },
      { name: 'Member Only D', cover: 'R25,000', premium: 'R200 per month' },
      { name: 'Member Executive', cover: 'R35,000', premium: 'R255 per month' },
    ],
  },
  {
    value: 'member-child', label: 'Member + Child', detail: 'Cover for yourself and a child.', image: '/images/about/member_child.png',
    linkedMembers: [{ value: 'dependant', label: 'Dependant', max: 6 }, { value: 'spouse', label: 'Spouse', max: 1 }],
    plans: [
      { name: 'Member + Child A', cover: 'R8,000', premium: 'R115 per month' },
      { name: 'Member + Child B', cover: 'R10,000', premium: 'R135 per month' },
      { name: 'Member + Child C', cover: 'R15,000', premium: 'R170 per month' },
      { name: 'Member + Child D', cover: 'R25,000', premium: 'R200 per month' },
      { name: 'Member + Child Executive', cover: 'R35,000', premium: 'R255 per month' },
    ],
  },
  {
    value: 'family', label: 'Family + Extended Family', detail: 'Cover your wider family circle.', image: '/images/about/member_extended_family.png',
    linkedMembers: [{ value: 'dependant', label: 'Dependant', max: 6 }, { value: 'spouse', label: 'Spouse', max: 1 }, { value: 'extended', label: 'Extended', max: 10 }],
    plans: [
      { name: 'Family A', cover: 'R8,000', premium: 'R125 per month' },
      { name: 'Family B', cover: 'R10,000', premium: 'R145 per month' },
      { name: 'Family C', cover: 'R15,000', premium: 'R190 per month' },
      { name: 'Family D', cover: 'R25,000', premium: 'R220 per month' },
      { name: 'Family Executive', cover: 'R35,000', premium: 'R280 per month' },
    ],
  },
  {
    value: 'top-up', label: 'Top-Up Cover', detail: 'Add cover to an existing policy.', image: '/images/about/top_up.png', linkedMembers: [],
    plans: [
      { name: 'Top-Up 5', cover: 'R5,000', premium: 'R70 per month' },
      { name: 'Top-Up 10', cover: 'R10,000', premium: 'Premium to be confirmed', unconfirmed: true },
      { name: 'Top-Up 15', cover: 'R15,000', premium: 'Premium to be confirmed', unconfirmed: true },
      { name: 'Top-Up 20', cover: 'R20,000', premium: 'Premium to be confirmed', unconfirmed: true },
      { name: 'Top-Up 25', cover: 'R25,000', premium: 'Premium to be confirmed', unconfirmed: true },
    ],
  },
];

const familyMemberSections = [
  { type: 'beneficiary', label: 'Beneficiary', description: 'Confirm the main policy beneficiary.' },
  { type: 'dependant', label: 'Dependants', description: 'Add your children or legal dependants.' },
  { type: 'spouse', label: 'Spouse', description: 'Add your spouse or life partner.' },
  { type: 'extended', label: 'Extended family', description: 'Add other family members you want to include.' },
];
const currentYear = new Date().getFullYear();
---

<div class="cover-discovery" id="find-cover" data-cover-discovery>
  <header class="choice-heading">
    <h2>Who do you want to cover?</h2>
    <p>Choose the option closest to your needs.</p>
  </header>

  <div class="plan-stage">
    <div class="choice-grid" data-choice-grid>
      {planGroups.map((group) => (
        <button class="choice-card" type="button" data-open-plans={group.value} aria-controls={`plans-${group.value}`} aria-label={`${group.label}. ${group.detail}`}>
          <img src={group.image} alt="" />
        </button>
      ))}
    </div>

    {planGroups.map((group) => (
      <section class="plan-panel" id={`plans-${group.value}`} data-plan-panel={group.value} hidden aria-labelledby={`plans-title-${group.value}`}>
        <header class="plan-panel-heading">
          <div><p class="eyebrow">{group.value === 'family' ? <>Family + <span class="family-plan-suffix">Extended</span> Family</> : group.label}</p><h3 id={`plans-title-${group.value}`} tabindex="-1">Choose a cover plan.</h3></div>
          <button class="plan-close" type="button" data-close-plans aria-label={`Close ${group.label} plans`}>×</button>
        </header>
        <div class="plan-grid">
          {group.plans.map((plan) => (
            <article class="plan-card" data-plan-card data-plan-name={plan.name} data-cover={plan.cover} data-base-premium={plan.premium.match(/\d+/)?.[0]}>
              <span class="plan-name">{/(?:[A-D]|Executive)$/.test(plan.name) ? <>{plan.name.slice(0, plan.name.endsWith('Executive') ? -'Executive'.length : -1)}<span class="family-plan-suffix">{plan.name.endsWith('Executive') ? 'Executive' : plan.name.at(-1)}</span></> : plan.name}</span><strong>{plan.cover} <em>COVERED</em></strong>
              {group.linkedMembers.length > 0 && (
                <div class="linked-members">
                  <div class="linked-member-rows">
                    {group.linkedMembers.map((member) => (
                      <div class="linked-member-row" data-member-row={member.value} data-max={member.max} data-count="0">
                        <span>{member.label}</span>
                        <div class="member-stepper">
                          <button type="button" data-member-minus aria-label={`Remove ${member.label}`}>−</button>
                          <output aria-live="polite">0</output>
                          <button type="button" data-member-plus aria-label={`Add ${member.label}`}>+</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <small class:list={['plan-premium', { unconfirmed: 'unconfirmed' in plan && plan.unconfirmed }]}>
                {'unconfirmed' in plan && plan.unconfirmed ? plan.premium : <><span class="monthly-price">R<span data-premium-value>{plan.premium.match(/\d+/)?.[0]}</span></span> per month</>}
              </small>
              <button class="plan-select" type="button" data-plan-select>Choose plan</button>
            </article>
          ))}
        </div>
        {group.value === 'top-up' && <p class="top-up-note">Only the R5,000 top-up premium is confirmed in the supplied product list. Additional top-up premiums require TIRO confirmation.</p>}
        <section class="funnel-step" data-funnel-step hidden>
          <aside class="funnel-visual">
            <div class="funnel-selected-copy">
              <p>You selected</p>
              <h4><span>TIRO</span> <strong data-selected-plan></strong></h4>
              <div>Quality, affordable<br />cover for everyday life.</div>
            </div>
            <div class="beneficiaries-card">
              <h5>
                <svg aria-hidden="true" viewBox="0 0 32 32"><circle cx="13" cy="9" r="6"></circle><path d="M3 27c0-7 4-11 10-11s10 4 10 11M22 13c4 0 7 3 7 8v4M23 25h7"></path></svg>
                Beneficiaries
              </h5>
              <dl>
                <div><dt>Main member</dt><dd data-main-member-name>You</dd></div>
                <div><dt data-beneficiary-label="dependant">Dependants</dt><dd data-beneficiary-count="dependant">0</dd></div>
                <div><dt data-beneficiary-label="spouse">Spouse</dt><dd data-beneficiary-count="spouse">0</dd></div>
                <div><dt data-beneficiary-label="extended">Extended family</dt><dd data-beneficiary-count="extended">0</dd></div>
              </dl>
            </div>
            <img class="funnel-woman" src="/woman_face.png" alt="TIRO consultant" width="1374" height="1145" />
          </aside>
          <div class="funnel-content">
            <form class="details-form">
              <div class="form-intro" data-form-intro hidden aria-label="TIRO introduction">
                <video data-form-intro-video src="/brand/logo reveal 2.mp4" muted playsinline preload="auto"></video>
              </div>
              <div class="step-loader-overlay" data-step-loader hidden aria-label="Loading next step" role="status">
                <div class="step-loader-main" aria-hidden="true">
                  <div class="step-loader-bars">{Array.from({ length: 9 }).map(() => <div class="step-loader-bar"></div>)}</div>
                  <div class="step-loader-balls">{Array.from({ length: 9 }).map((_, index) => <div class="step-loader-arm"><div class={`step-loader-ball ball${index}`}></div></div>)}</div>
                </div>
              </div>
              <div class="form-progress" aria-label="Application progress">
                <div class="form-progress-track" aria-hidden="true">
                  <i class="active" data-progress-dot="1">1</i><i data-progress-dot="2">2</i><i data-progress-dot="3">3</i><i data-progress-dot="4">4</i><i data-progress-dot="5">5</i><i data-progress-dot="6">6</i>
                </div>
              </div>
              <div class="details-fields form-step" data-details-fields data-form-step="1">
              <img class="form-logo" src="/brand/tiro-logo-primary.svg" alt="TIRO" width="180" height="72" />
              <h4>Update Details</h4>
              <p>Keep your personal information up to date.</p>
              <div class="details-grid">
                <label><span>Title <b>*</b></span><select name="title" required><option>Mr</option><option>Mrs</option><option>Ms</option><option>Dr</option></select></label>
                <label><span>Gender <b>*</b></span><select name="gender" required><option>Male</option><option>Female</option><option>Other</option></select></label>
                <label><span>Full name <b>*</b></span><input type="text" name="fullName" placeholder="Full name" autocomplete="given-name" minlength="2" required /></label>
                <label><span>Surname <b>*</b></span><input type="text" name="surname" placeholder="Surname" autocomplete="family-name" minlength="2" required /></label>
                <label><span>Number <b>*</b></span><span class="phone-verification" data-phone-verification><span class="phone-field" data-phone-entry><input type="tel" name="cellphone" placeholder="Cellphone number" autocomplete="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" title="Enter a 10-digit cellphone number" required /><button class="verify-action" type="button" data-verify-otp><span class="verify-action__icon-wrapper"><svg viewBox="0 0 14 15" fill="none" aria-hidden="true" class="verify-action__icon-svg" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg><svg viewBox="0 0 14 15" fill="none" aria-hidden="true" class="verify-action__icon-svg verify-action__icon-svg--copy" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg></span><span data-verify-label>Verify</span></button></span><span class="inline-otp" data-inline-otp hidden><span class="inline-otp-group">{Array.from({ length: 3 }).map((_, index) => <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete={index === 0 ? 'one-time-code' : 'off'} aria-label={`Verification digit ${index + 1}`} data-inline-otp-input />)}</span><i aria-hidden="true">–</i><span class="inline-otp-group">{Array.from({ length: 3 }).map((_, index) => <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label={`Verification digit ${index + 4}`} data-inline-otp-input />)}</span></span></span></label>
                <label><span>Email address <b>*</b></span><input type="email" name="email" placeholder="Email address" autocomplete="email" required /></label>
                <label><span>Preferred communication <b>*</b></span><select name="communication" required><option>Call Phone</option><option>WhatsApp</option><option>Email</option><option>SMS</option></select></label>
                <label><span>ID number <b>*</b></span><input type="text" name="idNumber" placeholder="ID number" inputmode="numeric" pattern="[0-9]{13}" maxlength="13" title="Enter a valid 13-digit ID number" required /></label>
              </div>
              <div class="details-actions">
                <button class="change-policy group relative h-14 w-full rounded-2xl bg-gray-800 text-center text-xl font-semibold text-white" type="button" data-change-policy>
                  <div class="absolute left-1 top-[4px] z-10 flex h-12 w-1/4 items-center justify-center rounded-xl bg-green-400 duration-500 group-hover:w-[calc(100%_-_8px)]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" height="25px" width="25px" aria-hidden="true">
                      <path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" fill="#000000"></path>
                      <path d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" fill="#000000"></path>
                    </svg>
                  </div>
                  <p class="translate-x-2">Change Policy</p>
                </button>
                <button class="save-details" type="button" data-next-step="2">
                  <div class="button-overlay"></div>
                  <span>Save Details
                    <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path>
                    </svg>
                  </span>
                </button>
              </div>
              </div>
              <section class="address-step form-step" data-form-step="2" hidden>
                <h4>Your address</h4>
                <p>Please confirm, edit or add your correct address.</p>
                <div class="details-grid address-grid">
                  <label><span>Address <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 3l9 8M5 10v10h14V10M9 20v-6h6v6"></path></svg><input type="text" name="address" placeholder="Address" autocomplete="street-address" required /></span></label>
                  <label><span>Suburb <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"></path><circle cx="12" cy="9" r="2"></circle></svg><input type="text" name="suburb" placeholder="Suburb" required /></span></label>
                  <label class="field-wide"><span>City <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V8h7v13M11 21V3h9v18M7 11h1M7 15h1M14 7h2M14 11h2M14 15h2M2 21h20"></path></svg><input type="text" name="city" placeholder="City" autocomplete="address-level2" required /></span></label>
                  <label><span>Code <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v13H3zM3 10h18M7 15h3M15 15h2"></path></svg><input type="text" name="postalCode" placeholder="Code" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" title="Enter a 4-digit postal code" required /></span></label>
                  <button class="search-code verify-action" type="button"><span class="verify-action__icon-wrapper"><svg viewBox="0 0 14 15" fill="none" aria-hidden="true" class="verify-action__icon-svg" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg><svg viewBox="0 0 14 15" fill="none" aria-hidden="true" class="verify-action__icon-svg verify-action__icon-svg--copy" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg></span>Search code</button>
                </div>
                <div class="address-actions">
                  <button class="change-policy group relative h-14 w-full rounded-2xl bg-gray-800 text-center text-xl font-semibold text-white" type="button" data-prev-step="1">
                    <div class="absolute left-1 top-[4px] z-10 flex h-12 w-1/4 items-center justify-center rounded-xl bg-green-400 duration-500 group-hover:w-[calc(100%_-_8px)]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" height="25px" width="25px" aria-hidden="true"><path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" fill="#000000"></path><path d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" fill="#000000"></path></svg></div>
                    <p class="translate-x-2">Back 1 step</p>
                  </button>
                  <button class="save-details" type="button" data-next-step="3"><div class="button-overlay"></div><span>Continue <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path></svg></span></button>
                </div>
              </section>
              <section class="family-step form-step" data-form-step="3" hidden>
                <h4>Add family members</h4>
                <p data-family-summary>Add the people included with this policy.</p>
                <p class="step-error" data-family-error hidden></p>
                <div class="member-tabs" role="tablist" aria-label="Linked member type">
                  {familyMemberSections.map((member, index) => <button class:list={['member-tab', { active: index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-member-tab={member.type}>{member.label}</button>)}
                </div>
                <div class="family-accordions">
                  {familyMemberSections.map((member, index) => (
                    <section class:list={['member-accordion', { open: index === 0 }]} data-family-member={member.type} data-target="1">
                      <button class="member-accordion-toggle" type="button" data-member-toggle aria-expanded={index === 0 ? 'true' : 'false'}>
                        <span class="member-type-icon" aria-hidden="true">
                          <svg viewBox="0 0 32 32"><circle cx="16" cy="9" r="5"></circle><path d="M7 27c0-8 3-12 9-12s9 4 9 12M4 27h24"></path></svg>
                        </span>
                        <span><strong>{member.label} (<output data-added-count>0</output>/<output data-target-count>1</output>)</strong><small>{member.description}</small></span>
                        <b aria-hidden="true">⌄</b>
                      </button>
                      <div class="member-accordion-content" data-member-content hidden={index !== 0}>
                        {member.type === 'beneficiary' ? (
                          <div class="member-fields beneficiary-fields">
                            <label><span>Name <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-5 3-8 8-8s8 3 8 8"></path></svg><input type="text" name="beneficiaryName" data-member-input placeholder="Name" /></span></label>
                            <label><span>Surname <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-5 3-8 8-8s8 3 8 8"></path></svg><input type="text" name="beneficiarySurname" data-member-input placeholder="Surname" /></span></label>
                            <label class="birth-field member-field-wide"><span>Date of birth <b>*</b></span><span><select name="beneficiaryBirthYear" aria-label="Birth year"><option value="">Year</option>{Array.from({ length: 100 }).map((_, index) => <option value={currentYear - index}>{currentYear - index}</option>)}</select><select name="beneficiaryBirthMonth" aria-label="Birth month"><option value="">Month</option>{Array.from({ length: 12 }).map((_, index) => <option value={index + 1}>{index + 1}</option>)}</select><select name="beneficiaryBirthDay" aria-label="Birth day"><option value="">Day</option>{Array.from({ length: 31 }).map((_, index) => <option value={index + 1}>{index + 1}</option>)}</select></span></label>
                            <label><span>Cellphone number <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h3l1 5-2 1c1 3 3 5 6 6l1-2 5 1v3c0 2-2 4-4 4C9 20 4 15 3 7c0-2 2-4 4-4Z"></path></svg><input type="tel" name="beneficiaryPhone" data-member-input placeholder="Cellphone number" /></span></label>
                            <label><span>Email address <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg><input type="email" name="beneficiaryEmail" data-member-input placeholder="Email address" /></span></label>
                            <label><span>ID number <small>(optional when DOB is provided)</small></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="8" cy="11" r="2"></circle><path d="M6 16h4M13 10h5M13 14h5"></path></svg><input type="text" name="beneficiaryId" data-member-input placeholder="ID number (optional)" inputmode="numeric" /></span></label>
                            <label><span>Your relationship with this person? <b>*</b></span><span class="input-with-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><circle cx="16" cy="9" r="3"></circle><path d="M3 20c0-5 2-8 6-8s6 3 6 8M13 14c1-.7 2-1 3-1 3 0 5 2 5 7"></path></svg><select name="beneficiaryRelationship"><option value="">Select relationship</option><option>Spouse</option><option>Child</option><option>Parent</option><option>Sibling</option><option>Other</option></select></span></label>
                          </div>
                        ) : (
                          <div class="member-fields">
                            <label><span>Name <b>*</b></span><input type="text" data-member-input placeholder="Name" /></label>
                            <label><span>Surname <b>*</b></span><input type="text" data-member-input placeholder="Surname" /></label>
                            <label><span>ID number <b>*</b></span><input type="text" data-member-input placeholder="ID number" inputmode="numeric" /></label>
                            <label class="birth-field"><span>Date of birth <b>*</b></span><span><select aria-label="Birth year"><option value="">Year</option>{Array.from({ length: 100 }).map((_, index) => <option value={currentYear - index}>{currentYear - index}</option>)}</select><select aria-label="Birth month"><option value="">Month</option>{Array.from({ length: 12 }).map((_, index) => <option value={index + 1}>{index + 1}</option>)}</select><select aria-label="Birth day"><option value="">Day</option>{Array.from({ length: 31 }).map((_, index) => <option value={index + 1}>{index + 1}</option>)}</select></span></label>
                            <label><span>Cellphone number</span><input type="tel" data-member-input placeholder="Cellphone number" /></label>
                            <div class="member-form-actions"><button type="button" data-member-cancel>Cancel</button><button type="button" data-add-member>Add {member.label}</button></div>
                          </div>
                        )}
                      </div>
                    </section>
                  ))}
                </div>
                <div class="family-actions">
                  <button class="change-policy group relative h-14 w-full rounded-2xl bg-gray-800 text-center text-xl font-semibold text-white" type="button" data-prev-step="2">
                    <div class="absolute left-1 top-[4px] z-10 flex h-12 w-1/4 items-center justify-center rounded-xl bg-green-400 duration-500 group-hover:w-[calc(100%_-_8px)]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" height="25px" width="25px" aria-hidden="true"><path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" fill="#000000"></path><path d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" fill="#000000"></path></svg></div>
                    <p class="translate-x-2">Back 1 step</p>
                  </button>
                  <button class="save-details" type="button" data-next-step="4"><div class="button-overlay"></div><span>Continue <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path></svg></span></button>
