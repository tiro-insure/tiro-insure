                <div class="review-actions">
                  <button class="change-policy group relative h-14 w-full rounded-2xl bg-gray-800 text-center text-xl font-semibold text-white" type="button" data-prev-step="4">
                    <div class="absolute left-1 top-[4px] z-10 flex h-12 w-1/4 items-center justify-center rounded-xl bg-green-400 duration-500 group-hover:w-[calc(100%_-_8px)]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" height="25px" width="25px" aria-hidden="true"><path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" fill="#000000"></path><path d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" fill="#000000"></path></svg></div>
                    <p class="translate-x-2">Back 1 step</p>
                  </button>
                  <button class="save-details" type="button" data-next-step="6"><div class="button-overlay"></div><span>Submit Application <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path></svg></span></button>
                </div>
              </section>
              <section class="success-step form-step" data-form-step="6" hidden>
                <div class="success-mark" aria-hidden="true"><span>✓</span></div>
                <p class="success-eyebrow">Application successful</p>
                <h4>Your TIRO cover is ready.</h4>
                <p class="success-copy">Here is a summary of the policy selected for your family circle.</p>
                <article class="success-policy-card">
                  <header><div><small>Selected policy</small><strong data-success-value="planName">—</strong></div><span data-success-value="coverAmount">—</span></header>
                  <dl>
                    <div><dt>Monthly premium</dt><dd data-success-value="monthlyPremium">—</dd></div>
                    <div><dt>People covered</dt><dd><span data-success-value="peopleCovered">1</span> person<span data-success-plural></span></dd></div>
                    <div><dt>Main member</dt><dd>1</dd></div>
                    <div data-success-member="dependant"><dt>Dependants</dt><dd data-success-value="dependants">0</dd></div>
                    <div data-success-member="spouse"><dt>Spouse</dt><dd data-success-value="spouse">0</dd></div>
                    <div data-success-member="extended"><dt>Extended family</dt><dd data-success-value="extended">0</dd></div>
                  </dl>
                </article>
                <p class="success-note">TIRO will confirm the final policy details and contact you using the information supplied.</p>
                <div class="success-actions">
                  <button class="change-policy group relative h-14 w-full rounded-2xl bg-gray-800 text-center text-xl font-semibold text-white" type="button" data-prev-step="5">
                    <div class="absolute left-1 top-[4px] z-10 flex h-12 w-1/4 items-center justify-center rounded-xl bg-green-400 duration-500 group-hover:w-[calc(100%_-_8px)]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" height="25px" width="25px" aria-hidden="true"><path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" fill="#000000"></path><path d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" fill="#000000"></path></svg></div>
                    <p class="translate-x-2">Back 1 step</p>
                  </button>
                  <a class="save-details success-done" href="/"><div class="button-overlay"></div><span>Done <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path></svg></span></a>
                </div>
              </section>
            </form>
          </div>
        </section>
      </section>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cover-discovery]').forEach((journey) => {
    const choiceGrid = journey.querySelector<HTMLElement>('[data-choice-grid]');
    if (!choiceGrid) return;
    let activeTrigger: HTMLButtonElement | null = null;

    journey.querySelectorAll<HTMLButtonElement>('[data-open-plans]').forEach((button) => {
      button.addEventListener('click', () => {
        const panel = journey.querySelector<HTMLElement>(`[data-plan-panel="${button.dataset.openPlans}"]`);
        if (!panel) return;
        journey.querySelectorAll<HTMLElement>('[data-plan-panel]').forEach((item) => { item.hidden = true; });
        activeTrigger = button;
        choiceGrid.hidden = true;
        panel.hidden = false;
        panel.querySelector<HTMLElement>('h3')?.focus();
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-close-plans]').forEach((button) => {
      button.addEventListener('click', () => {
        button.closest<HTMLElement>('[data-plan-panel]')?.setAttribute('hidden', '');
        choiceGrid.hidden = false;
        activeTrigger?.focus();
      });
    });

    const premiumAnimations = new WeakMap<HTMLElement, number>();
    const introTimers = new WeakMap<HTMLElement, number>();
    const playFormIntro = (form: HTMLFormElement) => {
      const intro = form.querySelector<HTMLElement>('[data-form-intro]');
      const video = intro?.querySelector<HTMLVideoElement>('[data-form-intro-video]');
      if (!intro || !video) return;
      const activeTimer = introTimers.get(form);
      if (activeTimer !== undefined) window.clearTimeout(activeTimer);
      intro.hidden = false;
      intro.classList.remove('is-fading');
      form.classList.add('is-intro-playing');
      video.pause();
      video.currentTime = 0;
      void video.play().catch(() => undefined);
      const timer = window.setTimeout(() => {
        intro.classList.add('is-fading');
        form.classList.remove('is-intro-playing');
        window.setTimeout(() => {
          intro.hidden = true;
          intro.classList.remove('is-fading');
          video.pause();
        }, 700);
        introTimers.delete(form);
      }, 5000);
      introTimers.set(form, timer);
    };
    const animatePremium = (element: HTMLElement, target: number) => {
      const activeFrame = premiumAnimations.get(element);
      if (activeFrame !== undefined) window.cancelAnimationFrame(activeFrame);
      const start = Number(element.textContent) || target;
      const startedAt = performance.now();
      const duration = 320;
      const tick = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        element.textContent = String(Math.round(start + ((target - start) * eased)));
        if (progress < 1) premiumAnimations.set(element, window.requestAnimationFrame(tick));
        else premiumAnimations.delete(element);
      };
      premiumAnimations.set(element, window.requestAnimationFrame(tick));
    };

    journey.querySelectorAll<HTMLElement>('[data-plan-card]').forEach((card) => {
      const premium = card.querySelector<HTMLElement>('[data-premium-value]');
      const planButton = card.querySelector<HTMLButtonElement>('[data-plan-select]');
      const rows = Array.from(card.querySelectorAll<HTMLElement>('[data-member-row]'));
      const basePremium = Number(card.dataset.basePremium);
      planButton?.addEventListener('click', () => {
        const panel = card.closest<HTMLElement>('[data-plan-panel]');
        const funnel = panel?.querySelector<HTMLElement>('[data-funnel-step]');
        if (!panel || !funnel) return;

        panel.querySelector<HTMLElement>('.plan-panel-heading')?.setAttribute('hidden', '');
        panel.querySelector<HTMLElement>('.plan-grid')?.setAttribute('hidden', '');
        panel.querySelector<HTMLElement>('.top-up-note')?.setAttribute('hidden', '');

        const selectedPlan = funnel.querySelector<HTMLElement>('[data-selected-plan]');
        if (selectedPlan) selectedPlan.textContent = card.dataset.planName ?? 'Selected plan';
        funnel.dataset.planName = card.dataset.planName ?? 'Selected plan';
        funnel.dataset.coverAmount = card.dataset.cover ?? 'To be confirmed';
        const displayedPremium = card.querySelector<HTMLElement>('[data-premium-value]')?.textContent?.trim();
        funnel.dataset.monthlyPremium = displayedPremium ? `R${displayedPremium} per month` : (card.querySelector<HTMLElement>('.plan-premium')?.textContent?.trim() ?? 'To be confirmed');
        ['dependant', 'spouse', 'extended'].forEach((type) => {
          const count = rows.find((row) => row.dataset.memberRow === type)?.dataset.count ?? '0';
          const output = funnel.querySelector<HTMLElement>(`[data-beneficiary-count="${type}"]`);
          if (output) output.textContent = count;
          funnel.dataset[`${type}Count`] = count;
        });
        const form = funnel.querySelector<HTMLFormElement>('.details-form');
        if (form) {
          form.querySelectorAll<HTMLElement>('[data-form-step]').forEach((section) => { section.hidden = section.dataset.formStep !== '1'; });
          form.querySelectorAll<HTMLElement>('[data-progress-dot]').forEach((dot) => {
            dot.classList.toggle('active', dot.dataset.progressDot === '1');
            dot.classList.remove('completed');
          });
          playFormIntro(form);
        }
        funnel.hidden = false;
        panel.classList.add('is-funnel-mode');
        window.requestAnimationFrame(() => card.closest<HTMLElement>('.plan-stage')?.classList.add('is-funnel-open'));
      });
      if (!premium || !planButton || rows.length === 0 || !Number.isFinite(basePremium)) return;

      const updateCard = () => {
        let linkedCount = 0;
        rows.forEach((row) => {
          const count = Number(row.dataset.count) || 0;
          const max = Number(row.dataset.max) || 0;
          const output = row.querySelector<HTMLOutputElement>('output');
          const minus = row.querySelector<HTMLButtonElement>('[data-member-minus]');
          const plus = row.querySelector<HTMLButtonElement>('[data-member-plus]');
          if (output) output.value = String(count);
          if (minus) minus.disabled = count === 0;
          if (plus) plus.disabled = count >= max;
          linkedCount += count;
        });
        animatePremium(premium, basePremium + (linkedCount * 55));
      };

      rows.forEach((row) => {
        row.querySelector<HTMLButtonElement>('[data-member-minus]')?.addEventListener('click', () => {
          row.dataset.count = String(Math.max(0, (Number(row.dataset.count) || 0) - 1));
          updateCard();
        });
        row.querySelector<HTMLButtonElement>('[data-member-plus]')?.addEventListener('click', () => {
          const max = Number(row.dataset.max) || 0;
          row.dataset.count = String(Math.min(max, (Number(row.dataset.count) || 0) + 1));
          updateCard();
        });
      });

    });

    const updateLinkedMemberNames = (section: HTMLElement) => {
      const type = section.dataset.familyMember ?? '';
      if (type === 'beneficiary') return;
      const funnel = section.closest<HTMLElement>('[data-funnel-step]');
      const label = funnel?.querySelector<HTMLElement>(`[data-beneficiary-label="${type}"]`);
      if (!label) return;
      const baseLabel = type === 'dependant' ? 'Dependants' : type === 'extended' ? 'Extended family' : 'Spouse';
      let names: string[] = [];
      try { names = JSON.parse(section.dataset.memberNames ?? '[]'); } catch { names = []; }
      label.textContent = names.length > 0 ? `${baseLabel} · ${names.join(', ')}` : baseLabel;
      label.title = names.length > 0 ? names.join(', ') : baseLabel;
    };

    const configureFamilyStep = (form: HTMLFormElement) => {
      const funnel = form.closest<HTMLElement>('[data-funnel-step]');
      const familyStep = form.querySelector<HTMLElement>('[data-form-step="3"]');
      if (!funnel || !familyStep) return;
      let linkedTotal = 0;
      familyStep.querySelectorAll<HTMLElement>('[data-family-member]').forEach((section) => {
        const type = section.dataset.familyMember ?? 'beneficiary';
        const target = type === 'beneficiary' ? 1 : Number(funnel.dataset[`${type}Count`]) || 0;
        linkedTotal += type === 'beneficiary' ? 0 : target;
        section.dataset.target = String(target);
        section.dataset.added = String(Math.min(Number(section.dataset.added) || 0, target));
        if (type !== 'beneficiary') {
          let names: string[] = [];
          try { names = JSON.parse(section.dataset.memberNames ?? '[]'); } catch { names = []; }
          section.dataset.memberNames = JSON.stringify(names.slice(0, Number(section.dataset.added) || 0));
          updateLinkedMemberNames(section);
        }
        section.hidden = target === 0 || type !== 'beneficiary';
        const targetOutput = section.querySelector<HTMLOutputElement>('[data-target-count]');
        const addedOutput = section.querySelector<HTMLOutputElement>('[data-added-count]');
        if (targetOutput) targetOutput.value = String(target);
        if (addedOutput) addedOutput.value = section.dataset.added;
        const tab = familyStep.querySelector<HTMLButtonElement>(`[data-member-tab="${type}"]`);
        if (tab) {
          tab.hidden = target === 0;
          tab.disabled = target === 0;
          tab.classList.toggle('active', type === 'beneficiary');
          tab.setAttribute('aria-selected', String(type === 'beneficiary'));
        }
      });
      const memberTabs = familyStep.querySelector<HTMLElement>('.member-tabs');
      const visibleTabs = familyStep.querySelectorAll<HTMLButtonElement>('[data-member-tab]:not([hidden])');
      if (memberTabs) memberTabs.hidden = visibleTabs.length <= 1;
      const summary = familyStep.querySelector<HTMLElement>('[data-family-summary]');
      if (summary) summary.textContent = linkedTotal === 0
        ? 'Add your beneficiary details.'
        : `Add your beneficiary and the ${linkedTotal} linked member${linkedTotal === 1 ? '' : 's'} selected with this policy.`;
    };

    const updateReview = (form: HTMLFormElement) => {
      const review = form.querySelector<HTMLElement>('[data-form-step="5"]');
      const funnel = form.closest<HTMLElement>('[data-funnel-step]');
      if (!review || !funnel) return;
      const value = (name: string) => {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        return field?.value.trim() || '—';
      };
      const set = (key: string, content: string) => {
        const output = review.querySelector<HTMLElement>(`[data-review-value="${key}"]`);
        if (output) output.textContent = content;
      };
      set('personalName', [value('title'), value('fullName'), value('surname')].filter((item) => item !== '—').join(' ') || '—');
      set('personalContact', [value('cellphone'), value('email')].filter((item) => item !== '—').join(' · ') || '—');
      set('personalId', value('idNumber'));
      set('address', value('address'));
      set('city', [value('suburb'), value('city')].filter((item) => item !== '—').join(', ') || '—');
      set('postalCode', value('postalCode'));
      set('dependants', funnel.dataset.dependantCount ?? '0');
      set('spouse', funnel.dataset.spouseCount ?? '0');
      set('extended', funnel.dataset.extendedCount ?? '0');
      set('beneficiaryName', [value('beneficiaryName'), value('beneficiarySurname')].filter((item) => item !== '—').join(' ') || '—');
      set('beneficiaryContact', [value('beneficiaryPhone'), value('beneficiaryEmail')].filter((item) => item !== '—').join(' · ') || '—');
      set('beneficiaryRelationship', value('beneficiaryRelationship'));
      set('bank', value('bankName'));
      const account = value('bankAccountNumber');
      set('account', account === '—' ? account : `•••• ${account.slice(-4)}`);
      set('debitDay', value('debitDay'));
    };

    const updateSuccess = (form: HTMLFormElement) => {
      const success = form.querySelector<HTMLElement>('[data-form-step="6"]');
      const funnel = form.closest<HTMLElement>('[data-funnel-step]');
      if (!success || !funnel) return;
      const counts = {
        dependant: Number(funnel.dataset.dependantCount) || 0,
        spouse: Number(funnel.dataset.spouseCount) || 0,
        extended: Number(funnel.dataset.extendedCount) || 0,
      };
      const set = (key: string, content: string) => {
        const output = success.querySelector<HTMLElement>(`[data-success-value="${key}"]`);
        if (output) output.textContent = content;
      };
      set('planName', funnel.dataset.planName ?? 'Selected plan');
      set('coverAmount', funnel.dataset.coverAmount ?? 'To be confirmed');
      set('monthlyPremium', funnel.dataset.monthlyPremium ?? 'To be confirmed');
      set('dependants', String(counts.dependant));
      set('spouse', String(counts.spouse));
      set('extended', String(counts.extended));
      const totalPeople = 1 + counts.dependant + counts.spouse + counts.extended;
      set('peopleCovered', String(totalPeople));
      const plural = success.querySelector<HTMLElement>('[data-success-plural]');
      if (plural) plural.textContent = totalPeople === 1 ? '' : 's';
      Object.entries(counts).forEach(([type, count]) => {
        const row = success.querySelector<HTMLElement>(`[data-success-member="${type}"]`);
        if (row) row.hidden = count === 0;
      });
    };

    const validateCurrentStep = (step: HTMLElement, stepNumber: number) => {
      step.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => {
        if (field.dataset.ruleError === 'true') {
          field.setCustomValidity('');
          delete field.dataset.ruleError;
        }
      });

      if (stepNumber === 1) {
        const verification = step.querySelector<HTMLElement>('[data-phone-verification]');
        const phone = verification?.querySelector<HTMLInputElement>('input[name="cellphone"]');
        if (phone && !verification?.classList.contains('verified') && phone.value.trim()) {
          phone.setCustomValidity('Please verify your cellphone number.');
          phone.dataset.ruleError = 'true';
        }
      }

      if (stepNumber === 3) {
        const error = step.querySelector<HTMLElement>('[data-family-error]');
        const beneficiaryTab = step.querySelector<HTMLButtonElement>('[data-member-tab="beneficiary"]');
        const beneficiary = step.querySelector<HTMLElement>('[data-family-member="beneficiary"]');
        const beneficiaryFields = Array.from(beneficiary?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select') ?? []).filter((field) => field.getAttribute('name') !== 'beneficiaryId');
        const missingBeneficiary = beneficiaryFields.find((field) => !field.value.trim() || !field.checkValidity());
        if (missingBeneficiary) {
          beneficiaryTab?.click();
          missingBeneficiary.setCustomValidity('Complete all beneficiary details.');
          missingBeneficiary.dataset.ruleError = 'true';
          if (error) {
            error.textContent = 'Complete all beneficiary details before continuing.';
            error.hidden = false;
          }
          missingBeneficiary.reportValidity();
          missingBeneficiary.focus();
          return false;
        }

        const incompleteSection = Array.from(step.querySelectorAll<HTMLElement>('[data-family-member]')).find((section) => {
          if (section.dataset.familyMember === 'beneficiary') return false;
          return (Number(section.dataset.added) || 0) < (Number(section.dataset.target) || 0);
        });
        if (incompleteSection) {
          const type = incompleteSection.dataset.familyMember ?? '';
          step.querySelector<HTMLButtonElement>(`[data-member-tab="${type}"]`)?.click();
          if (error) {
            const label = type === 'dependant' ? 'dependants' : type === 'extended' ? 'extended family members' : 'spouse';
            error.textContent = `Add all selected ${label} before continuing.`;
            error.hidden = false;
          }
          incompleteSection.querySelector<HTMLInputElement>('input')?.focus();
          return false;
        }
        if (error) error.hidden = true;
      }

      const invalidField = Array.from(step.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')).find((field) => !field.checkValidity());
      if (invalidField) {
        invalidField.reportValidity();
        invalidField.focus();
        return false;
      }
      return true;
    };

    const showFormStep = (form: HTMLFormElement, step: number) => {
      if (step === 3) configureFamilyStep(form);
      if (step === 5) updateReview(form);
      if (step === 6) updateSuccess(form);
      const current = form.querySelector<HTMLElement>('[data-form-step]:not([hidden])');
      const next = form.querySelector<HTMLElement>(`[data-form-step="${step}"]`);
      if (!next || current === next) return;
      const currentNumber = Number(current?.dataset.formStep) || step;
      const direction = step > currentNumber ? 'forward' : 'backward';
      current?.classList.add(`step-exit-${direction}`);
      window.setTimeout(() => {
        form.querySelectorAll<HTMLElement>('[data-form-step]').forEach((section) => {
          section.hidden = section !== next;
          section.classList.remove('step-exit-forward', 'step-exit-backward', 'step-enter-forward', 'step-enter-backward');
        });
        next.hidden = false;
        next.classList.add(`step-enter-${direction}`);
        window.setTimeout(() => next.classList.remove(`step-enter-${direction}`), 360);
        form.querySelectorAll<HTMLElement>('[data-progress-dot]').forEach((dot) => {
          const dotStep = Number(dot.dataset.progressDot);
          dot.classList.toggle('active', dotStep === step);
          dot.classList.toggle('completed', dotStep < step);
        });
        const heading = next.querySelector<HTMLElement>('h4');
        heading?.setAttribute('tabindex', '-1');
        heading?.focus({ preventScroll: true });
      }, current ? 180 : 0);
    };

    journey.querySelectorAll<HTMLButtonElement>('[data-next-step], [data-prev-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const form = button.closest<HTMLFormElement>('.details-form');
        const targetStep = Number(button.dataset.nextStep ?? button.dataset.prevStep);
        if (!form || !Number.isFinite(targetStep) || !form.querySelector(`[data-form-step="${targetStep}"]`)) return;
        const currentStep = form.querySelector<HTMLElement>('[data-form-step]:not([hidden])');
        const currentNumber = Number(currentStep?.dataset.formStep);
        if (button.hasAttribute('data-next-step') && targetStep > currentNumber && currentStep && !validateCurrentStep(currentStep, currentNumber)) return;
        if (button.hasAttribute('data-next-step')) {
          const loader = form.querySelector<HTMLElement>('[data-step-loader]');
          if (loader) {
            loader.hidden = false;
            form.setAttribute('aria-busy', 'true');
            window.setTimeout(() => {
              showFormStep(form, targetStep);
              window.setTimeout(() => {
                loader.hidden = true;
                form.removeAttribute('aria-busy');
              }, 190);
            }, 2000);
            return;
          }
        }
        showFormStep(form, targetStep);
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-review-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest<HTMLElement>('.review-item');
        const body = item?.querySelector<HTMLElement>('.review-body');
        if (!item || !body) return;
        const willOpen = body.hidden === true;
        toggle.setAttribute('aria-expanded', String(willOpen));
        if (willOpen) {
          const review = item.closest<HTMLElement>('.review-step');
          review?.querySelectorAll<HTMLElement>('.review-item.open').forEach((openItem) => {
            if (openItem === item) return;
            openItem.classList.remove('open');
            const openBody = openItem.querySelector<HTMLElement>('.review-body');
            const openToggle = openItem.querySelector<HTMLButtonElement>('[data-review-toggle]');
            if (openBody) openBody.hidden = true;
            openToggle?.setAttribute('aria-expanded', 'false');
          });
          body.hidden = false;
          item.classList.remove('closing');
          item.classList.add('open');
        } else {
          item.classList.add('closing');
          window.setTimeout(() => {
            body.hidden = true;
            item.classList.remove('open', 'closing');
          }, 240);
        }
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-edit-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const form = button.closest<HTMLFormElement>('.details-form');
        const step = Number(button.dataset.editStep);
        if (!form || !Number.isFinite(step)) return;
        const reviewItem = button.closest<HTMLElement>('.review-item');
        if (reviewItem) {
          reviewItem.classList.remove('open', 'closing');
          const reviewBody = reviewItem.querySelector<HTMLElement>('.review-body');
          if (reviewBody) reviewBody.hidden = true;
        }
        showFormStep(form, step);
        if (step !== 3) return;
        const familyStep = form.querySelector<HTMLElement>('[data-form-step="3"]');
        if (!familyStep) return;
        let tab: HTMLButtonElement | undefined;
        if (button.dataset.editMember === 'beneficiary') {
          tab = familyStep.querySelector<HTMLButtonElement>('[data-member-tab="beneficiary"]') ?? undefined;
        } else {
          tab = Array.from(familyStep.querySelectorAll<HTMLButtonElement>('[data-member-tab]')).find((item) => item.dataset.memberTab !== 'beneficiary' && !item.hidden);
        }
        tab?.click();
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-verify-otp]').forEach((button) => {
      button.addEventListener('click', () => {
        const verification = button.closest<HTMLElement>('[data-phone-verification]');
        const entry = verification?.querySelector<HTMLElement>('[data-phone-entry]');
        const otp = verification?.querySelector<HTMLElement>('[data-inline-otp]');
        const phoneInput = entry?.querySelector<HTMLInputElement>('input[name="cellphone"]');
        if (!entry || !otp || !phoneInput) return;
        if (!/^\d{10}$/.test(phoneInput.value.trim())) {
          phoneInput.setCustomValidity('Enter a valid 10-digit cellphone number.');
          phoneInput.reportValidity();
          return;
        }
        phoneInput.setCustomValidity('Enter the verification code.');
        entry.hidden = true;
        otp.hidden = false;
        otp.querySelector<HTMLInputElement>('[data-inline-otp-input]')?.focus();
      });
    });

    journey.querySelectorAll<HTMLInputElement>('input[name="fullName"], input[name="surname"]').forEach((input) => {
      input.addEventListener('input', () => {
        const form = input.closest<HTMLFormElement>('.details-form');
        const funnel = form?.closest<HTMLElement>('[data-funnel-step]');
        if (!form || !funnel) return;
        const firstName = (form.elements.namedItem('fullName') as HTMLInputElement | null)?.value.trim() ?? '';
        const surname = (form.elements.namedItem('surname') as HTMLInputElement | null)?.value.trim() ?? '';
        const memberName = [firstName, surname].filter(Boolean).join(' ') || 'You';
        const output = funnel.querySelector<HTMLElement>('[data-main-member-name]');
        if (output) output.textContent = memberName;
      });
    });

    journey.querySelectorAll<HTMLElement>('[data-inline-otp]').forEach((otp) => {
      const inputs = Array.from(otp.querySelectorAll<HTMLInputElement>('[data-inline-otp-input]'));
      const verification = otp.closest<HTMLElement>('[data-phone-verification]');
      const entry = verification?.querySelector<HTMLElement>('[data-phone-entry]');
      const phoneInput = entry?.querySelector<HTMLInputElement>('input[name="cellphone"]');
      const verifyButton = entry?.querySelector<HTMLButtonElement>('[data-verify-otp]');
      const verifyLabel = verifyButton?.querySelector<HTMLElement>('[data-verify-label]');
      const syncCode = () => {
        const code = inputs.map((input) => input.value).join('');
        const complete = code.length === 6;
        const verified = code === '123456';
        otp.classList.toggle('verified', verified);
        otp.classList.toggle('invalid', complete && !verified);
        phoneInput?.setCustomValidity(verified ? '' : complete ? 'Incorrect code. Use 123456.' : 'Enter the verification code.');
        if (verified) {
          window.setTimeout(() => {
            otp.hidden = true;
            if (entry) entry.hidden = false;
            verification?.classList.add('verified');
            if (verifyButton) {
              verifyButton.disabled = true;
            }
            if (verifyLabel) verifyLabel.textContent = 'Verified';
          }, 350);
        }
      };

      phoneInput?.addEventListener('input', () => {
        verification?.classList.remove('verified');
        phoneInput.setCustomValidity(phoneInput.value.trim() ? 'Please verify this number.' : '');
        if (verifyButton) {
          verifyButton.disabled = false;
        }
        if (verifyLabel) verifyLabel.textContent = 'Verify';
      });

      inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
          input.value = input.value.replace(/\D/g, '').slice(-1);
          syncCode();
          if (input.value && index < inputs.length - 1) inputs[index + 1]?.focus();
        });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Backspace' && !input.value && index > 0) inputs[index - 1]?.focus();
          if (event.key === 'ArrowLeft' && index > 0) inputs[index - 1]?.focus();
          if (event.key === 'ArrowRight' && index < inputs.length - 1) inputs[index + 1]?.focus();
        });
        input.addEventListener('paste', (event) => {
          event.preventDefault();
          const digits = event.clipboardData?.getData('text').replace(/\D/g, '').slice(0, 6) ?? '';
          digits.split('').forEach((digit, digitIndex) => { if (inputs[digitIndex]) inputs[digitIndex].value = digit; });
          syncCode();
          inputs[Math.max(0, Math.min(digits.length, 6) - 1)]?.focus();
        });
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-member-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const section = toggle.closest<HTMLElement>('[data-family-member]');
        const content = section?.querySelector<HTMLElement>('[data-member-content]');
        if (!section || !content) return;
        const willOpen = content.hidden === true;
        content.hidden = !willOpen;
        section.classList.toggle('open', willOpen);
        toggle.setAttribute('aria-expanded', String(willOpen));
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-member-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const familyStep = tab.closest<HTMLElement>('[data-form-step="3"]');
        if (!familyStep) return;
        familyStep.querySelectorAll<HTMLButtonElement>('[data-member-tab]').forEach((item) => {
          const selected = item === tab;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-selected', String(selected));
        });
        familyStep.querySelectorAll<HTMLElement>('[data-family-member]').forEach((section) => {
          const selected = section.dataset.familyMember === tab.dataset.memberTab;
          section.hidden = !selected;
          section.classList.toggle('open', selected);
          const content = section.querySelector<HTMLElement>('[data-member-content]');
          const toggle = section.querySelector<HTMLButtonElement>('[data-member-toggle]');
          if (content) content.hidden = !selected;
          toggle?.setAttribute('aria-expanded', String(selected));
        });
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-member-cancel]').forEach((button) => {
      button.addEventListener('click', () => {
        const section = button.closest<HTMLElement>('[data-family-member]');
        const content = section?.querySelector<HTMLElement>('[data-member-content]');
        if (!section || !content) return;
        content.hidden = true;
        section.classList.remove('open');
        section.querySelector<HTMLButtonElement>('[data-member-toggle]')?.setAttribute('aria-expanded', 'false');
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-add-member]').forEach((button) => {
      button.addEventListener('click', () => {
        const section = button.closest<HTMLElement>('[data-family-member]');
        if (!section) return;
        const requiredFields = Array.from(section.querySelectorAll<HTMLLabelElement>('label')).filter((label) => label.querySelector('b')).flatMap((label) => Array.from(label.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')));
        requiredFields.forEach((field) => field.setCustomValidity(''));
        const missingField = requiredFields.find((field) => !field.value.trim() || !field.checkValidity());
        if (missingField) {
          missingField.setCustomValidity('Complete this field before adding the member.');
          missingField.reportValidity();
          missingField.focus();
          return;
        }
        const target = Number(section.dataset.target) || 0;
        const previousAdded = Number(section.dataset.added) || 0;
        const added = Math.min(target, previousAdded + 1);
        if (added > previousAdded) {
          const memberInputs = Array.from(section.querySelectorAll<HTMLInputElement>('[data-member-input]'));
          const memberName = [memberInputs[0]?.value.trim(), memberInputs[1]?.value.trim()].filter(Boolean).join(' ');
          let names: string[] = [];
          try { names = JSON.parse(section.dataset.memberNames ?? '[]'); } catch { names = []; }
          if (memberName) names.push(memberName);
          section.dataset.memberNames = JSON.stringify(names);
        }
        section.dataset.added = String(added);
        const output = section.querySelector<HTMLOutputElement>('[data-added-count]');
        if (output) output.value = String(added);
        section.querySelectorAll<HTMLInputElement>('[data-member-input]').forEach((input) => { input.value = ''; });
        section.querySelectorAll<HTMLSelectElement>('select').forEach((select) => { select.selectedIndex = 0; });
        const familyError = section.closest<HTMLElement>('[data-form-step="3"]')?.querySelector<HTMLElement>('[data-family-error]');
        if (familyError) familyError.hidden = true;
        updateLinkedMemberNames(section);
        button.disabled = added >= target;
        if (added >= target) button.textContent = 'Added';
      });
    });

    journey.querySelectorAll<HTMLButtonElement>('[data-change-policy]').forEach((changeButton) => {
      changeButton.addEventListener('click', () => {
        const funnel = changeButton.closest<HTMLElement>('[data-funnel-step]');
        const panel = funnel?.closest<HTMLElement>('[data-plan-panel]');
        if (!funnel || !panel) return;
        panel.querySelector<HTMLElement>('.plan-panel-heading')?.removeAttribute('hidden');
        panel.querySelector<HTMLElement>('.plan-grid')?.removeAttribute('hidden');
        panel.querySelector<HTMLElement>('.top-up-note')?.removeAttribute('hidden');
        funnel.hidden = true;
        panel.classList.remove('is-funnel-mode');
        panel.closest<HTMLElement>('.plan-stage')?.classList.remove('is-funnel-open');
        panel.querySelector<HTMLButtonElement>('[data-plan-select]')?.focus();
      });
    });

    const visuals = Array.from(journey.querySelectorAll<HTMLElement>('.choice-visual'));
    if ('IntersectionObserver' in window) {
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add('is-revealed');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.25 });
      visuals.forEach((visual) => imageObserver.observe(visual));
    } else {
      visuals.forEach((visual) => visual.classList.add('is-revealed'));
    }
  });
</script>

