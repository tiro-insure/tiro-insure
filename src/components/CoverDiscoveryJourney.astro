                    <dl class="review-body" hidden><div><dt>Dependants</dt><dd data-review-value="dependants">0</dd></div><div><dt>Spouse</dt><dd data-review-value="spouse">0</dd></div><div><dt>Extended family</dt><dd data-review-value="extended">0</dd></div></dl>
                  </article>
                  <article class="review-item">
                    <div class="review-item-head"><button type="button" data-review-toggle aria-expanded="false"><svg class="review-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="7" r="4"></circle><path d="M3 21c0-5 2-8 7-8 2 0 3.5.5 4.6 1.5"></path><circle cx="18" cy="18" r="3"></circle><path d="m16.8 18 1 1 1.8-2"></path></svg><span><strong>Beneficiary</strong><small>Beneficiary details and relationship</small></span><b>⌄</b></button><button type="button" data-edit-step="3" data-edit-member="beneficiary">Edit</button></div>
                    <dl class="review-body" hidden><div><dt>Name</dt><dd data-review-value="beneficiaryName">—</dd></div><div><dt>Contact</dt><dd data-review-value="beneficiaryContact">—</dd></div><div><dt>Relationship</dt><dd data-review-value="beneficiaryRelationship">—</dd></div></dl>
                  </article>
                  <article class="review-item">
                    <div class="review-item-head"><button type="button" data-review-toggle aria-expanded="false"><svg class="review-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20M6 15h4"></path></svg><span><strong>Payment details</strong><small>Bank account and debit order information</small></span><b>⌄</b></button><button type="button" data-edit-step="4">Edit</button></div>
                    <dl class="review-body" hidden><div><dt>Bank</dt><dd data-review-value="bank">—</dd></div><div><dt>Account</dt><dd data-review-value="account">—</dd></div><div><dt>Debit day</dt><dd data-review-value="debitDay">—</dd></div></dl>
                  </article>
