  .choice-visual { position: relative; overflow: hidden; background: var(--tiro-navy); clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); }
  .choice-visual b { position: absolute; inset: 0; background-image: url('/brand/campaigns/a_clean_grid_style_advertisement_poster_layout_s.png'); background-repeat: no-repeat; background-size: 318% 200%; clip-path: inset(0 100% 0 0); transform: scale(1.08); transition: clip-path 800ms cubic-bezier(.22, 1, .36, 1), transform 1050ms cubic-bezier(.22, 1, .36, 1); }
