                  <button class="save-details" type="button" data-next-step="5"><div class="button-overlay"></div><span>Complete Application <svg width="53" height="58" viewBox="0 0 53 58" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M44.25 36.3612L17.25 51.9497C11.5833 55.2213 4.5 51.1318 4.50001 44.5885L4.50001 13.4115C4.50001 6.86824 11.5833 2.77868 17.25 6.05033L44.25 21.6388C49.9167 24.9104 49.9167 33.0896 44.25 36.3612Z" stroke="currentColor" stroke-width="9"></path></svg></span></button>
