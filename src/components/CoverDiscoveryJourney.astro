                    <dl class="review-body" hidden><div><dt>Name</dt><dd data-review-value="personalName">—</dd></div><div><dt>Contact</dt><dd data-review-value="personalContact">—</dd></div><div><dt>ID number</dt><dd data-review-value="personalId">—</dd></div></dl>
                  </article>
                  <article class="review-item">
                    <div class="review-item-head"><button type="button" data-review-toggle aria-expanded="false"><svg class="review-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"></path><path d="M5 10v11h14V10M9 21v-7h6v7"></path></svg><span><strong>Address</strong><small>Residential address and postal code</small></span><b>⌄</b></button><button type="button" data-edit-step="2">Edit</button></div>
                    <dl class="review-body" hidden><div><dt>Address</dt><dd data-review-value="address">—</dd></div><div><dt>Suburb and city</dt><dd data-review-value="city">—</dd></div><div><dt>Postal code</dt><dd data-review-value="postalCode">—</dd></div></dl>
