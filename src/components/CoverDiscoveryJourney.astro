  .plan-panel-heading .eyebrow { margin: 0 0 5px; }
  .plan-panel-heading h3 { margin: 0; color: var(--tiro-navy); font-size: clamp(1.35rem, 2.3vw, 1.9rem); line-height: 1.1; }
  .plan-close { display: grid; width: 38px; height: 38px; flex: 0 0 auto; place-items: center; border: 1px solid #cdd7e5; border-radius: 50%; background: white; color: var(--tiro-navy); cursor: pointer; font-size: 1.5rem; }
  .plan-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .plan-card { display: flex; min-width: 0; flex-direction: column; padding: 16px 13px; border: 1px solid var(--tiro-light-grey); border-radius: 14px; background: var(--tiro-soft-white); }
  .plan-name { min-height: 0; color: var(--tiro-blue); font-size: .68rem; font-weight: 850; line-height: 1.25; text-transform: uppercase; }
  .family-plan-suffix { color: var(--tiro-red); }
  .plan-card > strong { margin-top: 4px; color: var(--tiro-navy); font-size: .95rem; }
  .plan-card > strong em { font-size: .52rem; font-style: normal; font-weight: 850; letter-spacing: .04em; }
  .plan-card > small { min-height: 1.5em; margin-top: 8px; color: #596579; font-size: .72rem; line-height: 1.35; }
  .plan-card > small.unconfirmed { color: #8a5b00; }
  .monthly-price { color: var(--tiro-navy); font-size: .8rem; font-weight: 850; }
  .linked-members { display: grid !important; margin-top: 7px; }
  .linked-member-rows { display: grid; gap: 4px; }
