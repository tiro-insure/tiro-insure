---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="section"><div class="container intro"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p><a class="button button-secondary" href="/">Back to home <span aria-hidden="true">›</span></a></div></section>
<style>.intro { max-width: 760px; }.intro h1 { margin: 16px 0; color: var(--tiro-navy); font-size: clamp(2.6rem, 5vw, 4rem); line-height: 1.08; letter-spacing: -.04em; }.intro > p:not(.eyebrow) { max-width: 640px; font-size: 1.15rem; }.intro .button { margin-top: 20px; }</style>
